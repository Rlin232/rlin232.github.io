---

<Layout
  title="Curriculum Vitae | Ryan Y. Lin"
  description="Academic and professional curriculum vitae of Ryan Y. Lin"
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 pt-20 sm:pt-24 pb-20">
    <!-- Top Action Breadcrumb & PDF Button -->
    <div
      class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 sm:mb-8"
    >
      <a
        href="/"
        class="inline-flex items-center gap-2 text-xs text-sky-300 hover:text-sky-200 transition-colors"
      >
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg
        >
        <span>Back to Home</span>
      </a>

      <a
        href="/assets/pdf/cv.pdf"
        target="_blank"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-sky-500/20 text-sky-200 border border-sky-400/30 text-xs font-medium hover:bg-sky-500/30 transition-all"
        title="Download Official PDF Resume"
      >
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
          ></path></svg
        >
        <span>Download PDF CV</span>
      </a>
    </div>

    <!-- Header Billboard -->
    <div
      class="p-6 sm:p-8 md:p-10 rounded-3xl glass-panel border border-white/5 mb-10"
    >
      <div
        class="flex flex-col md:flex-row md:items-center justify-between gap-6"
      >
        <div>
          <div
            class="text-xs text-sky-300 font-medium uppercase tracking-wider mb-2"
          >
            Curriculum Vitae
          </div>
          <h1
            class="text-4xl md:text-5xl font-bold font-outfit text-white mb-2"
          >
            {personalInfo.fullName}
          </h1>
          <p class="text-slate-300 text-base md:text-lg font-light">
            AI Researcher at <span class="text-white font-medium">DRW</span> • Current
            M.S. CS at <span class="text-white font-medium">Stanford</span> • <span
              class="text-white font-medium">Caltech</span
            > B.S. CS
          </p>
        </div>

        <div class="flex flex-wrap gap-2.5 text-xs">
          <a
            href={`mailto:${personalInfo.email}`}
            class="px-3.5 py-1.5 rounded-xl bg-white/5 border border-white/10 hover:border-sky-400/30 text-slate-300 transition-colors"
          >
            {personalInfo.email}
          </a>
          <a
            href={`https://github.com/${personalInfo.github}`}
            target="_blank"
            rel="noopener noreferrer"
            class="px-3.5 py-1.5 rounded-xl bg-white/5 border border-white/10 hover:border-sky-400/30 text-slate-300 transition-colors"
          >
            GitHub
          </a>
          <a
            href={`https://linkedin.com/in/${personalInfo.linkedin}`}
            target="_blank"
            rel="noopener noreferrer"
            class="px-3.5 py-1.5 rounded-xl bg-white/5 border border-white/10 hover:border-sky-400/30 text-slate-300 transition-colors"
          >
            LinkedIn
          </a>
          <div
            class="px-3.5 py-1.5 rounded-xl bg-sky-500/10 border border-sky-500/20 text-sky-300"
            title="Erdős Number 3: Ryan Lin → Anima Anandkumar → Béla Bollobás → Paul Erdős"
          >
            Erdős Number: {personalInfo.erdosNumber}
          </div>
        </div>
      </div>
    </div>

    <!-- Section 1: Education -->
    <section
      class="p-6 sm:p-8 md:p-10 rounded-3xl glass-panel border border-white/10 mb-8"
    >
      <h2
        class="text-2xl font-bold font-outfit text-white mb-8 flex items-center gap-3"
      >
        <span class="w-2 h-6 bg-sky-400 rounded-full"></span>
        <span>Education</span>
      </h2>
      <div class="space-y-8">
        {
          education.map((edu) => (
            <div class="border-l-2 border-white/10 pl-6 space-y-2">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1">
                <h3 class="text-xl font-bold text-white">{edu.title}</h3>
                <span class="font-mono text-xs text-sky-400 bg-sky-500/10 border border-sky-500/20 px-3 py-1 rounded-full w-fit">
                  {edu.year}
                </span>
              </div>
              <div class="text-base text-slate-300 font-medium">
                {edu.institution}
              </div>
              <ul class="list-disc pl-5 space-y-1.5 text-sm text-slate-400 font-light pt-2">
                {edu.descriptions.map((desc) => (
                  <li class="leading-relaxed">{desc}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Section 2: Experience -->
    <section
      class="p-6 sm:p-8 md:p-10 rounded-3xl glass-panel border border-white/10 mb-8"
    >
      <h2
        class="text-2xl font-bold font-outfit text-white mb-8 flex items-center gap-3"
      >
        <span class="w-2 h-6 bg-sky-400 rounded-full"></span>
        <span>Experience</span>
      </h2>
      <div class="space-y-10">
        {
          experience.map((exp) => (
            <div class="border-l-2 border-white/10 pl-6 space-y-2">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1">
                <h3 class="text-xl font-bold text-white">{exp.title}</h3>
                <span class="font-mono text-xs text-sky-400 bg-sky-500/10 border border-sky-500/20 px-3 py-1 rounded-full w-fit">
                  {exp.year}
                </span>
              </div>
              <div class="text-base text-slate-300 font-medium">
                {exp.institution}
              </div>
              <ul class="list-disc pl-5 space-y-1.5 text-sm text-slate-400 font-light pt-2">
                {exp.descriptions.map((desc) => (
                  <li class="leading-relaxed">{desc}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Section 3: Publications -->
    <section
      class="p-6 sm:p-8 md:p-10 rounded-3xl glass-panel border border-white/10 mb-8"
    >
      <h2
        class="text-2xl font-bold font-outfit text-white mb-8 flex items-center gap-3"
      >
        <span class="w-2 h-6 bg-sky-400 rounded-full"></span>
        <span>Publications</span>
      </h2>
      <div class="space-y-6">
        {
          publications.map((pub) => {
            const badge = getVenueBadge(pub.venue, pub.highlight);
            return (
              <div class="p-6 rounded-2xl bg-slate-900/60 border border-white/10 flex flex-col md:flex-row md:items-start justify-between gap-4">
                <div class="flex-grow">
                  <h3 class="text-lg font-bold text-white mb-1.5">
                    {pub.links.url ? (
                      <a
                        href={pub.links.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="hover:text-sky-300 transition-colors"
                      >
                        {pub.title}
                      </a>
                    ) : (
                      pub.title
                    )}
                  </h3>
                  <p class="text-xs text-slate-400 mb-2">
                    {pub.authors.map((author, aIdx) => (
                      <span
                        class={
                          author.includes("Ryan Y. Lin")
                            ? "text-sky-300 font-medium"
                            : ""
                        }
                      >
                        {author}
                        {aIdx < pub.authors.length - 1 ? ", " : ""}
                      </span>
                    ))}
                  </p>
                  <div class="flex items-center gap-2">
                    {badge && <div set:html={badge} />}
                    <span class="font-mono text-xs text-slate-500">
                      {pub.year}
                    </span>
                  </div>
                </div>

                <div class="flex items-center gap-2 shrink-0">
                  {pub.links.pdf && (
                    <a
                      href={pub.links.pdf}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="px-3 py-1.5 rounded-lg bg-white/5 hover:bg-white/10 text-slate-300 border border-white/10 font-mono text-xs transition-colors"
                    >
                      PDF
                    </a>
                  )}
                  {pub.links.url && (
                    <a
                      href={pub.links.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="px-3 py-1.5 rounded-lg bg-white/5 hover:bg-white/10 text-slate-300 border border-white/10 font-mono text-xs transition-colors"
                    >
                      LINK
                    </a>
                  )}
                </div>
              </div>
            );
          })
        }
      </div>
    </section>

    <!-- Section 4: Skills -->
    <section class="p-6 sm:p-8 md:p-10 rounded-3xl glass-panel border border-white/10">
      <h2
        class="text-2xl font-bold font-outfit text-white mb-8 flex items-center gap-3"
      >
        <span class="w-2 h-6 bg-sky-400 rounded-full"></span>
        <span>Technical Skills</span>
      </h2>
      <div class="space-y-6">
        {
          skills.map((grp) => (
            <div>
              <h3 class="font-mono text-xs text-sky-400 uppercase tracking-wider mb-3">
                {grp.category}
              </h3>
              <div class="flex flex-wrap gap-2">
                {grp.items.map((item) => (
                  <span class="px-3 py-1.5 rounded-lg bg-slate-900 border border-white/5 font-mono text-xs text-slate-300">
                    {item}
                  </span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </section>
  </div>
</Layout>
