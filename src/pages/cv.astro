---
import Layout from "../layouts/Layout.astro";
import { publications } from "../data/publications";

function getVenueBadge(venue: string, highlight?: boolean): string | null {
  const venues = ["NeurIPS", "ICML", "ICLR", "CVPR", "TMLR"];
  const match = venues.find((v) => venue.includes(v));
  if (!match) return null;

  if (highlight) {
    return `<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs bg-sky-500/10 text-sky-300 border border-sky-400/20">${match} Spotlight</span>`;
  }
  return `<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs bg-white/5 text-slate-300 border border-white/10">${match}</span>`;
}

const personalInfo = {
