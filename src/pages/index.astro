	<!-- Client Scripts: Dynamic Scroll-Linked Fade-In / Fade-Out & Interactions -->
	<script is:inline>
		// Dynamic Scroll-Linked Fade In & Fade Out Engine
		const fadeZones = document.querySelectorAll(".scroll-fade-zone");

		const updateFadeZones = () => {
			const vh = window.innerHeight;

			fadeZones.forEach((zone) => {
				const rect = zone.getBoundingClientRect();

				// Zone enters from bottom
				// Fully visible when top is between vh*0.75 and bottom is above vh*0.25
				// Fades out as top approaches top/leaves screen
				let opacity = 1;
				let translateY = 0;

				if (rect.top > vh * 0.75) {
					// Entering from bottom
					const t = Math.max(
						0,
						Math.min(1, 1 - (rect.top - vh * 0.75) / (vh * 0.28)),
					);
					opacity = t * t * (3 - 2 * t); // Smooth Hermite curve
					translateY = (1 - opacity) * 28;
				} else if (rect.bottom < vh * 0.35) {
					// Leaving through top
					const t = Math.max(
						0,
						Math.min(1, rect.bottom / (vh * 0.35)),
					);
					opacity = t * t * (3 - 2 * t);
					translateY = -(1 - opacity) * 28;
				}

				zone.style.opacity = Math.max(0, Math.min(1, opacity)).toFixed(
					3,
				);
				zone.style.transform = `translateY(${translateY.toFixed(1)}px)`;
				zone.style.pointerEvents = opacity < 0.15 ? "none" : "auto";
			});
		};

		window.addEventListener("scroll", updateFadeZones, { passive: true });
		window.addEventListener("resize", updateFadeZones);
		// Initial trigger
		updateFadeZones();

		// Toast Helper
		const showToast = (msg = "Copied to clipboard") => {
			const toast = document.getElementById("toast");
			if (toast) {
				toast.innerText = msg;
				toast.classList.remove("hidden");
				void toast.offsetWidth;
				toast.classList.remove("translate-y-24", "opacity-0");
				toast.classList.add("translate-y-0", "opacity-100");
				setTimeout(() => {
					toast.classList.add("translate-y-24", "opacity-0");
					toast.classList.remove("translate-y-0", "opacity-100");
					setTimeout(() => {
						toast.classList.add("hidden");
					}, 350);
				}, 2000);
			}
		};

		// Copy Email
		const copyEmailBtn = document.getElementById("copy-email-btn");
		const copyEmailHint = document.getElementById("copy-email-hint");
		if (copyEmailBtn) {
			copyEmailBtn.addEventListener("click", () => {
				navigator.clipboard
					.writeText("rlin232@stanford.edu")
					.then(() => {
						if (copyEmailHint)
							copyEmailHint.innerText = "✓ Copied to clipboard!";
						showToast("Copied: rlin232@stanford.edu");
						setTimeout(() => {
							if (copyEmailHint)
								copyEmailHint.innerText =
									"rlin232@stanford.edu (Click to Copy)";
						}, 2000);
					});
			});
		}

		// Copy BibTeX
		document.querySelectorAll(".copy-bibtex-btn").forEach((btn) => {
			btn.addEventListener("click", () => {
				const bibtex = btn.getAttribute("data-bibtex");
				if (bibtex) {
					navigator.clipboard.writeText(bibtex.trim()).then(() => {
						showToast("✓ BibTeX copied to clipboard");
					});
				}
			});
		});

		// Publication filtering
		const filterButtons = document.querySelectorAll(".pub-filter-btn");
		const pubCards = document.querySelectorAll(".pub-card");

		filterButtons.forEach((btn) => {
			btn.addEventListener("click", () => {
				filterButtons.forEach((b) => {
					b.classList.remove("bg-white/15", "text-white");
					b.classList.add("bg-transparent", "text-slate-400");
				});
				btn.classList.add("bg-white/15", "text-white");
				btn.classList.remove("bg-transparent", "text-slate-400");

				const filter = btn.dataset.filter;
				pubCards.forEach((card) => {
					const venue = card.dataset.venue || "";
					const isHighlight = card.dataset.highlight === "true";

					if (filter === "all") {
						card.style.display = "flex";
					} else if (filter === "highlight" && isHighlight) {
						card.style.display = "flex";
					} else if (
						filter === "neurips" &&
						venue.includes("neurips")
					) {
						card.style.display = "flex";
					} else if (filter === "cvpr" && venue.includes("cvpr")) {
						card.style.display = "flex";
					} else {
						card.style.display = "none";
					}
				});
			});
		});

		// Typewriter Effect (Frameless & clean, like original website)
		const typewriterEl = document.getElementById("typewriter");
		if (typewriterEl) {
			const boldStyle = "text-white font-bold text-[1.2em]";
			const isMobile = window.innerWidth < 640;
			const segments = isMobile
				? [
						{ text: "AI Researcher in Quant Finance @ " },
						{ text: "DRW", className: boldStyle },
						{ isBreak: true },
						{ text: "prev. ML @ " },
						{ text: "Apple", className: boldStyle },
						{ isBreak: true },
						{ text: "M.S. CS @ " },
						{ text: "Stanford", className: boldStyle },
						{ text: " | " },
						{ text: "Caltech", className: boldStyle },
						{ text: " Alum" },
				  ]
				: [
						{ text: "AI Researcher in Quant Finance @ " },
						{ text: "DRW", className: boldStyle },
						{ text: " | prev. ML @ " },
						{ text: "Apple", className: boldStyle },
						{ isBreak: true },
						{ text: "M.S. CS @ " },
						{ text: "Stanford", className: boldStyle },
						{ text: " | " },
						{ text: "Caltech", className: boldStyle },
						{ text: " Alum" },
				  ];

			// Clear initial fallback for dynamic typing
			typewriterEl.innerHTML = "";

			let segIdx = 0;
			let charIdx = 0;
			let currentSpan = null;

			function typeWriter() {
				if (segIdx >= segments.length) return;

				const currentSeg = segments[segIdx];

				if (currentSeg.isBreak) {
					typewriterEl.appendChild(document.createElement("br"));
					segIdx++;
					charIdx = 0;
					setTimeout(typeWriter, 140);
					return;
				}

				if (charIdx === 0) {
					if (currentSeg.className) {
						currentSpan = document.createElement("span");
						currentSpan.className = currentSeg.className;
						typewriterEl.appendChild(currentSpan);
					} else {
						currentSpan = document.createTextNode("");
						typewriterEl.appendChild(currentSpan);
					}
				}

				const char = currentSeg.text[charIdx];
				if (currentSpan.nodeType === Node.TEXT_NODE) {
					currentSpan.nodeValue += char;
				} else {
					currentSpan.textContent += char;
				}

				charIdx++;

				if (charIdx >= currentSeg.text.length) {
					segIdx++;
					charIdx = 0;
				}

				let delay = 28;
				if (char === "|") delay = 180;
				else if (char === "@") delay = 80;

				setTimeout(typeWriter, delay);
			}

			// Smooth start after mount
			setTimeout(typeWriter, 350);
		}
	</script>
</Layout>
