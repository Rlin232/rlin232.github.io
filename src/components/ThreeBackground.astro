<canvas
    id="bg-canvas"
    class="fixed inset-0 w-full h-full pointer-events-none z-0"
></canvas>

<script>
    import * as THREE from 'three';

    const canvas = document.querySelector("#bg-canvas");
    if (canvas) {
        const scene = new THREE.Scene();
        // Rich twilight atmospheric palette
        const skyColor = new THREE.Color('#050813');
        scene.background = skyColor;
        scene.fog = new THREE.FogExp2('#050813', 0.018);

        // --- 1. SINUOUS RIVER PATH FORMULA ---
        const getRiverX = (z) => {
            return Math.sin(z * 0.075) * 5.5 + Math.cos(z * 0.035) * 2.5;
        };

        // --- 1B. UNIFIED GENTLE SPATIALLY-COHERENT WIND FIELD ---
        // Prevailing wind direction wandering organically over time, gentle breeze waves across nearby patches
        const getWindAt = (x, z, t) => {
            // Wandering prevailing wind angle (cycles organically over tens of seconds)
            const wanderAngle = Math.sin(t * 0.08) * 0.85 + Math.cos(t * 0.043) * 0.55 + 0.8;

            // Traveling gentle spatial gust waves across the valley (low spatial frequencies)
            const wave1 = Math.sin(x * 0.055 + z * 0.075 - t * 1.05);
            const wave2 = Math.cos(x * 0.095 - z * 0.065 - t * 1.45) * 0.35;
            const wave3 = Math.sin(x * 0.035 - z * 0.040 + t * 0.45) * 0.20;

            // Gentle breathing envelope [0.45, 1.0] - continuous serene airflow
            const gust = 0.60 + 0.30 * wave1 + 0.12 * wave2 + 0.08 * wave3;

            // Subtle patch vorticity keeping close patches aligned with gentle macro variation
            const localAngle = wanderAngle + (wave2 + wave3) * 0.18;

            const dirX = Math.cos(localAngle);
            const dirZ = Math.sin(localAngle);

            return {
                dirX,
                dirZ,
                strength: gust,
                fx: dirX * gust,
                fz: dirZ * gust
            };
        };

        const getViewportSize = () => {
            const isMobile = window.innerWidth < 768;
            const w = window.innerWidth;
            // On mobile devices, ensure height covers full physical screen including dynamic bars & curved bottom
            const h = isMobile
                ? Math.max(window.innerHeight, window.screen ? window.screen.height : 0, document.documentElement.clientHeight)
                : window.innerHeight;
            return { w, h };
        };

        const { w: initW, h: initH } = getViewportSize();

        // Camera setup centered directly over the river channel
        const camera = new THREE.PerspectiveCamera(50, initW / initH, 0.1, 200);
        camera.position.set(getRiverX(24), 7.2, 24);
        camera.lookAt(getRiverX(6), 1.8, 6);

        // High-resolution Renderer with ACES Filmic Tonemapping
        const renderer = new THREE.WebGLRenderer({
            canvas: canvas,
            alpha: true,
            antialias: true,
            powerPreference: "high-performance"
        });
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2.5));
        renderer.setSize(initW, initH, false);
        renderer.toneMapping = THREE.ACESFilmicToneMapping;
        renderer.toneMappingExposure = 1.15;

        // Cinematic Natural Lighting
        const ambientLight = new THREE.AmbientLight(0x162032, 1.5);
        scene.add(ambientLight);

        const moonLight = new THREE.DirectionalLight(0xc7e8fe, 1.9);
        moonLight.position.set(-1, 20, -35);
        scene.add(moonLight);

        // --- 2. PRECISE ANTI-SPILL TERRAIN & ELEVATED RIVERBANK FORMULA ---
        const getTerrainHeight = (x, z) => {
            const rx = getRiverX(z);
            const distToRiver = Math.abs(x - rx);

            let baseY = 0;
            if (distToRiver < 3.2) {
                // Sinuous river channel bed (below waterLevel = -0.10)
                const t = distToRiver / 3.2;
                baseY = -1.15 + t * t * 0.8; // -1.15 at center, -0.35 at waterline boundary
            } else {
                // Elevated protective riverbank (rises rapidly and decisively above water level)
                const bankDist = distToRiver - 3.2;
                // Steep bank ascent: reaches +0.85 by bankDist = 1.4
                const bankRise = Math.min(bankDist * 0.95, 3.2);

                const h1 = Math.sin(x * 0.08) * Math.cos(z * 0.08) * 1.8;
                const h2 = Math.sin(x * 0.18 + z * 0.14) * 0.45;
                const h3 = Math.cos(x * 0.35 - z * 0.28) * 0.18;

                // Base bank height ensures water (-0.10) CANNOT spill over banks
                const minBankFloor = -0.35 + bankRise;
                const hills = h1 * 0.75 + h2 + h3;

                // Near the shore (bankDist < 1.8), ensure terrain is strictly >= +0.25
                if (bankDist < 1.8) {
                    const blend = bankDist / 1.8;
                    baseY = minBankFloor + Math.max(hills, 0.0) * blend;
                } else {
                    // Beyond the bank crest, rolling meadow hills
                    baseY = Math.max(minBankFloor + hills, 0.45);
                }
            }

            // --- WATERFALL CLIFF CHASM AT THE EDGE OF THE WORLD (z < -42.0) ---
            // As the river reaches the edge, the channel and canyon gorge plunge sheer into the abyss
            if (z < -42.0) {
                const cliffT = Math.min(Math.max((-42.0 - z) / 6.0, 0.0), 1.0);
                if (distToRiver < 4.5) {
                    baseY -= Math.pow(cliffT, 2.2) * 18.0;
                } else if (distToRiver < 8.5) {
                    const bluffBlend = 1.0 - (distToRiver - 4.5) / 4.0;
                    baseY -= Math.pow(cliffT, 2.0) * 14.0 * bluffBlend;
                }
            }

            return baseY;
        };

        // --- 3. ULTRA HIGH-RES PROCEDURAL TERRAIN (220x220 SEGMENTS) ---
        const terrainWidth = 100;
        const terrainDepth = 100;
        const terrainSegments = 220;
        const terrainGeom = new THREE.PlaneGeometry(terrainWidth, terrainDepth, terrainSegments, terrainSegments);
        terrainGeom.rotateX(-Math.PI / 2);

        const posAttr = terrainGeom.attributes.position;
        const colorAttr = new Float32Array(posAttr.count * 3);

        const colRiverbed = new THREE.Color('#030814'); // Pebble riverbed
        const colWetShore = new THREE.Color('#061420'); // Wet shoreline lapped by water
        const colBank = new THREE.Color('#081926');     // Shoreline bank
        const colMeadow = new THREE.Color('#0a1e28');   // Lush twilight grass
        const colRidge = new THREE.Color('#0e283c');    // Moonlit hill crest

        for (let i = 0; i < posAttr.count; i++) {
            const x = posAttr.getX(i);
            const z = posAttr.getZ(i);

            const y = getTerrainHeight(x, z);
            posAttr.setY(i, y);

            const rx = getRiverX(z);
            const distToRiver = Math.abs(x - rx);
            let vertexCol = colMeadow;

            if (distToRiver < 3.2) {
                vertexCol = colRiverbed.clone().lerp(colWetShore, distToRiver / 3.2);
            } else if (distToRiver < 4.8) {
                const shoreBlend = (distToRiver - 3.2) / 1.6;
                vertexCol = colWetShore.clone().lerp(colBank, shoreBlend);
            } else {
                const blend = Math.min(Math.max((y - 0.4) / 3.0, 0), 1);
                vertexCol = colBank.clone().lerp(colRidge, blend);
            }

            // Dark wet basaltic rock coloring for plunging waterfall cliffs
            if (z < -42.0 && y < -0.8) {
                const cliffDepth = Math.min(Math.max((-y - 0.8) / 10.0, 0.0), 1.0);
                vertexCol = vertexCol.clone().lerp(new THREE.Color('#01040a'), cliffDepth * 0.78);
            }

            colorAttr[i * 3 + 0] = vertexCol.r;
            colorAttr[i * 3 + 1] = vertexCol.g;
            colorAttr[i * 3 + 2] = vertexCol.b;
        }

        terrainGeom.setAttribute('color', new THREE.BufferAttribute(colorAttr, 3));
        terrainGeom.computeVertexNormals();

        const terrainMat = new THREE.MeshStandardMaterial({
            vertexColors: true,
            roughness: 0.88,
            metalness: 0.08,
            flatShading: false
        });
        const terrain = new THREE.Mesh(terrainGeom, terrainMat);
        scene.add(terrain);

        // --- 4. ULTRA HIGH-DENSITY GERSTNER FLUID SIMULATION (240x360 SEGMENTS CONCENTRATED ON RIVER) ---
        // 86,400 vertices concentrated directly across the 36-unit active river corridor
        const waterGeom = new THREE.PlaneGeometry(48, 96, 260, 360);
        waterGeom.rotateX(-Math.PI / 2);

        const rippleUniforms = [
            new THREE.Vector4(0, 0, -100, 0),
            new THREE.Vector4(0, 0, -100, 0),
            new THREE.Vector4(0, 0, -100, 0),
            new THREE.Vector4(0, 0, -100, 0),
            new THREE.Vector4(0, 0, -100, 0),
            new THREE.Vector4(0, 0, -100, 0),
            new THREE.Vector4(0, 0, -100, 0),
            new THREE.Vector4(0, 0, -100, 0)
        ];

        const waterMat = new THREE.ShaderMaterial({
            transparent: true,
            depthWrite: true,
            uniforms: {
                uTime: { value: 0 },
                uWaterCursor: { value: new THREE.Vector4(0, 0, 0, 0) },
                uRipples: { value: rippleUniforms },
                uDeepColor: { value: new THREE.Color('#020613') },
                uShallowColor: { value: new THREE.Color('#071c32') },
                uHighlightColor: { value: new THREE.Color('#7dd3fc') },
                uMoonLightColor: { value: new THREE.Color('#c7e8fe') },
                uFoamColor: { value: new THREE.Color('#e0f2fe') }
            },
            vertexShader: `
                uniform float uTime;
                uniform vec4 uWaterCursor; // (x, z, smoothSpeed, activeIntensity)
                uniform vec4 uRipples[8];  // (x, z, birthTime, strength)
                varying vec3 vWorldPos;
                varying vec3 vNormal;
                varying float vElevation;
                varying float vFoam;
                varying float vRippleDisplacement;

                // Trochoidal Gerstner Wave: generates sharp crests and broad troughs
                vec3 gerstnerWave(vec2 p, vec2 dir, float steepness, float wavelength, float speed) {
                    float k = 6.2831853 / wavelength;
                    float c = sqrt(9.81 / k) * speed;
                    vec2 d = normalize(dir);
                    float f = k * (dot(d, p) - c * uTime);
                    float a = steepness / k;

                    return vec3(
                        d.x * (a * cos(f)),
                        a * sin(f),
                        d.y * (a * cos(f))
                    );
                }

                // Sinuous river centerline formula matching terrain
                float getRiverCenter(float z) {
                    return sin(z * 0.075) * 5.5 + cos(z * 0.035) * 2.5;
                }

                vec3 computeWaterDisplacement(vec2 p) {
                    // Multi-scale Gerstner wave packets flowing downstream along Z (gentle serpentine river flow)
                    vec3 disp = vec3(0.0);
                    disp += gerstnerWave(p, vec2(0.05, 0.998), 0.12, 7.5, 0.85);
                    disp += gerstnerWave(p, vec2(-0.06, 0.998), 0.07, 4.4, 1.05);
                    disp += gerstnerWave(p, vec2(0.08, 0.996), 0.035, 2.2, 1.30);
                    disp += gerstnerWave(p, vec2(-0.05, 0.998), 0.020, 1.1, 1.55);

                    // 1. Continuous Butter-Smooth Hydrodynamic Cursor Wake (Tuned calm moving splash)
                    float distCursor = length(p - uWaterCursor.xy);
                    float cursorRadius = 3.0;
                    float wakeEnv = exp(-distCursor * distCursor / (cursorRadius * cursorRadius)) * uWaterCursor.w;

                    // Still: depression is 0.13, moving gently rises to 0.20 (smooth and gentle, never too high)
                    disp.y -= wakeEnv * 0.24 * clamp(uWaterCursor.z * 0.14 + 0.55, 0.55, 0.88);
                    // Still: capillary ripple is 0.11, moving gently rises to 0.18
                    disp.y += sin(distCursor * 6.2 - uTime * 7.5) * wakeEnv * 0.20 * clamp(uWaterCursor.z * 0.16 + 0.55, 0.55, 0.90);

                    // 2. Propagating Wave Rings (8-Pulse Buffer with Smooth Cubic Fade-in - gentle calm ripples)
                    for (int i = 0; i < 8; i++) {
                        vec4 rip = uRipples[i];
                        float age = uTime - rip.z;
                        if (age > 0.0 && age < 4.8) {
                            // Ripple origin drifts downstream with the river velocity
                            vec2 center = vec2(rip.x, rip.y + age * 0.85);
                            float dist = length(p - center);
                            
                            float waveSpeed = 3.8;
                            float waveRadius = age * waveSpeed;
                            float delta = dist - waveRadius;

                            // Smooth cubic fade-in to prevent any pop, followed by exponential decay
                            float fadeIn = smoothstep(0.0, 0.20, age);
                            float fadeOut = exp(-age * 0.65);
                            float envelope = exp(-delta * delta * 0.85) * fadeIn * fadeOut;
                            float rippleWave = sin(delta * 5.6) * envelope * 0.18 * rip.w;
                            
                            disp.y += rippleWave;
                        }
                    }

                    return disp;
                }

                void main() {
                    vec3 pos = position;
                    vec3 disp = computeWaterDisplacement(pos.xz);

                    // Multi-scale base wave for differential ripple tracking
                    vec3 baseWave = vec3(0.0);
                    baseWave += gerstnerWave(pos.xz, vec2(0.05, 0.998), 0.12, 7.5, 0.85);
                    baseWave += gerstnerWave(pos.xz, vec2(-0.06, 0.998), 0.07, 4.4, 1.05);
                    baseWave += gerstnerWave(pos.xz, vec2(0.08, 0.996), 0.035, 2.2, 1.30);
                    baseWave += gerstnerWave(pos.xz, vec2(-0.05, 0.998), 0.020, 1.1, 1.55);
                    
                    // Apply trochoidal displacement
                    pos.x -= disp.x;
                    pos.z -= disp.z;
                    pos.y = -0.1 + disp.y;

                    // Waterfall brink plunge at the edge of the world (z < -42.0)
                    float brinkT = smoothstep(-42.0, -47.0, pos.z);
                    if (brinkT > 0.0) {
                        pos.y -= pow(brinkT, 2.3) * 11.5;
                        pos.z -= brinkT * 1.4;
                    }

                    vElevation = disp.y;
                    vRippleDisplacement = disp.y - baseWave.y;

                    vec4 worldPos = modelMatrix * vec4(pos, 1.0);
                    vWorldPos = worldPos.xyz;

                    // High-accuracy analytical finite-difference surface normal
                    float eps = 0.05;
                    vec3 dispX = computeWaterDisplacement(pos.xz + vec2(eps, 0.0));
                    vec3 dispZ = computeWaterDisplacement(pos.xz + vec2(0.0, eps));
                    float dYdX = (dispX.y - disp.y) / eps;
                    float dYdZ = (dispZ.y - disp.y) / eps;
                    vNormal = normalize(vec3(-dYdX, 1.0, -dYdZ));

                    // Shoreline frothy boundary foam detection (natural organic lapping without lattice grids)
                    float rx = getRiverCenter(pos.z);
                    float distToCenter = abs(pos.x - rx);
                    float shoreProximity = smoothstep(2.5, 3.3, distToCenter);
                    float shorePhase = pos.z * 2.4 - uTime * 1.8;
                    float shoreLapping = sin(shorePhase + sin(pos.x * 3.2 + shorePhase * 0.4)) * 0.5 + 0.5;
                    vFoam = shoreProximity * smoothstep(0.20, 0.75, shoreLapping);

                    gl_Position = projectionMatrix * viewMatrix * worldPos;
                }
            `,
            fragmentShader: `
                uniform float uTime;
                uniform vec4 uWaterCursor;
                uniform vec4 uRipples[8];
                uniform vec3 uDeepColor;
                uniform vec3 uShallowColor;
                uniform vec3 uHighlightColor;
                uniform vec3 uMoonLightColor;
                uniform vec3 uFoamColor;
                varying vec3 vWorldPos;
                varying vec3 vNormal;
                varying float vElevation;
                varying float vFoam;
                varying float vRippleDisplacement;

                void main() {
                    vec3 viewDir = normalize(cameraPosition - vWorldPos);
                    vec3 normal = normalize(vNormal);

                    // Exact Schlick Fresnel reflectance for air-water interface (n = 1.333, R0 = 0.020)
                    float cosTheta = max(0.0, dot(viewDir, normal));
                    float fresnel = 0.02 + 0.98 * pow(1.0 - cosTheta, 5.0);

                    // Depth absorption via Beer-Lambert law
                    vec3 waterCol = mix(uDeepColor, uShallowColor, smoothstep(-0.14, 0.14, vElevation));
                    
                    // Twilight sky reflection towards distant horizon
                    vec3 skyReflect = mix(uHighlightColor, vec3(0.08, 0.16, 0.26), 0.35);

                    // Multi-frequency organic water flow shimmer (NO diamond lattice)
                    vec2 pFlow = vWorldPos.xz * 1.4 + vec2(0.0, uTime * 0.75);
                    float w1 = sin(pFlow.x * 1.73 + pFlow.y * 2.21);
                    float w2 = sin(pFlow.x * -1.37 + pFlow.y * 3.19 + 1.4);
                    float w3 = sin(pFlow.x * 2.43 - pFlow.y * 1.57 + 2.8);

                    // Phase-modulated fluid micro-facets (streamlines rather than rectilinear facets)
                    vec2 microDisp = vec2(
                        sin(pFlow.y * 2.8 + w1 * 1.3) * 0.020 + cos(pFlow.x * 2.2 + w2) * 0.015,
                        cos(pFlow.x * 2.6 + w2 * 1.3) * 0.020 + sin(pFlow.y * 2.4 + w3) * 0.015
                    );
                    vec3 microNormal = normalize(normal + vec3(microDisp.x, 0.0, microDisp.y));

                    // Celestial directional moonlight specular highlights (Blinn-Phong)
                    vec3 moonDir = normalize(vec3(-0.02, 0.70, -0.92));
                    vec3 halfDir = normalize(moonDir + viewDir);
                    float spec = pow(max(0.0, dot(microNormal, halfDir)), 48.0);
                    float broadGlint = pow(max(0.0, dot(microNormal, moonDir)), 6.0) * 0.20;

                    // Composite Fresnel blend, glints, and surface sheen
                    vec3 finalCol = mix(waterCol, skyReflect, fresnel * 0.68 + broadGlint);
                    finalCol += uMoonLightColor * spec * 0.88;

                    // --- RADIANT LUMINOUS CURSOR RIPPLE & EXPANDING WAVE CRESTS ---
                    // 1. Concentric radiant rings around cursor
                    float distCursor = length(vWorldPos.xz - uWaterCursor.xy);
                    float cursorHalo = exp(-distCursor * distCursor / 8.5) * uWaterCursor.w;
                    float cursorRings = sin(distCursor * 6.5 - uTime * 7.5);
                    float ringCrests = smoothstep(0.18, 0.90, cursorRings) * cursorHalo;

                    // 2. Propagating wave rings shimmer
                    float pulseRings = 0.0;
                    for (int i = 0; i < 8; i++) {
                        vec4 rip = uRipples[i];
                        float age = uTime - rip.z;
                        if (age > 0.0 && age < 4.8) {
                            vec2 center = vec2(rip.x, rip.y + age * 0.85);
                            float dist = length(vWorldPos.xz - center);
                            float waveRadius = age * 3.8;
                            float delta = dist - waveRadius;
                            float ringEnv = exp(-delta * delta * 1.4) * smoothstep(0.0, 0.22, age) * exp(-age * 0.62);
                            pulseRings += smoothstep(0.15, 0.85, sin(delta * 5.6)) * ringEnv * rip.w;
                        }
                    }

                    // 3. Dynamic luminous aquatic crest shimmer (Sky-Cyan & Pure Starlight White)
                    float rippleShimmerIntensity = clamp(ringCrests * 0.85 + pulseRings * 0.55 + max(0.0, vRippleDisplacement * 2.0), 0.0, 1.0);
                    vec3 rippleColor = mix(vec3(0.38, 0.82, 1.0), vec3(0.95, 0.98, 1.0), smoothstep(0.35, 0.85, rippleShimmerIntensity));
                    finalCol += rippleColor * (rippleShimmerIntensity * 0.72);

                    // Subtle shoreline foam
                    finalCol = mix(finalCol, uFoamColor, vFoam * 0.42);

                    // Rushing white-water rapids and foaming spray as water reaches the waterfall brink
                    float waterfallBrink = smoothstep(-42.0, -46.5, vWorldPos.z);
                    if (waterfallBrink > 0.0) {
                        float rushFlow = vWorldPos.z * 5.5 - uTime * 11.0;
                        float rushStreaks = sin(rushFlow + sin(vWorldPos.x * 6.0 + rushFlow * 0.4)) * 0.5 + 0.5;
                        float rushFoam = smoothstep(0.18, 0.70, rushStreaks) * waterfallBrink;
                        finalCol = mix(finalCol, vec3(0.94, 0.98, 1.0), rushFoam * 0.88);
                        finalCol += vec3(0.35, 0.75, 1.0) * (waterfallBrink * 0.40);
                    }

                    // Serene atmospheric depth haze
                    float dist = length(vWorldPos - cameraPosition);
                    float fogFactor = smoothstep(10.0, 56.0, dist);
                    finalCol = mix(finalCol, vec3(0.02, 0.03, 0.07), fogFactor * 0.96);

                    gl_FragColor = vec4(finalCol, 0.94);
                }
            `
        });

        const river = new THREE.Mesh(waterGeom, waterMat);
        scene.add(river);

        // --- 5. DETAILED PROCEDURAL MULTI-BRANCH TREES ---
        // Construct a stylized multi-cluster organic pine/cedar tree
        const createDetailedTreeGeom = () => {
            const group = new THREE.Group();

            // 1. Tapered Wooden Trunk extending 1.1 units below ground to ensure trees on hills/slopes never have exposed stump bottoms
            const trunkGeom = new THREE.CylinderGeometry(0.14, 0.38, 3.8, 8);
            trunkGeom.translate(0, 0.8, 0); // Bottom is at y = -1.1, top is at y = +2.7
            const trunkMat = new THREE.MeshStandardMaterial({
                color: 0x1f1610, // Dark cedar bark
                roughness: 0.9
            });
            const trunkMesh = new THREE.Mesh(trunkGeom, trunkMat);
            group.add(trunkMesh);

            // 2. Angled Branches
            const branchGeom = new THREE.CylinderGeometry(0.06, 0.12, 1.2, 6);
            branchGeom.translate(0, 0.6, 0);
            
            const b1 = new THREE.Mesh(branchGeom, trunkMat);
            b1.position.set(0, 1.2, 0);
            b1.rotation.set(0.3, 0.5, 0.6);
            group.add(b1);

            const b2 = new THREE.Mesh(branchGeom, trunkMat);
            b2.position.set(0, 1.5, 0);
            b2.rotation.set(-0.4, 2.0, -0.5);
            group.add(b2);

            const b3 = new THREE.Mesh(branchGeom, trunkMat);
            b3.position.set(0, 1.8, 0);
            b3.rotation.set(0.2, -1.5, 0.4);
            group.add(b3);

            // 3. Dense Organic Foliage Canopies (Deformed low-poly spheres)
            const foliageMat = new THREE.MeshStandardMaterial({
                color: 0x061e1c, // Rich twilight pine
                roughness: 0.8,
                metalness: 0.1,
                flatShading: true
            });

            const makeFoliageCluster = (r, x, y, z) => {
                const geom = new THREE.IcosahedronGeometry(r, 1);
                // Subtle organic perturbation
                const pos = geom.attributes.position;
                for (let i = 0; i < pos.count; i++) {
                    const vx = pos.getX(i);
                    const vy = pos.getY(i);
                    const vz = pos.getZ(i);
                    const factor = 1.0 + Math.sin(vx * 3.0) * Math.cos(vy * 3.0) * 0.18;
                    pos.setXYZ(i, vx * factor, vy * factor, vz * factor);
                }
                geom.computeVertexNormals();
                const m = new THREE.Mesh(geom, foliageMat);
                m.position.set(x, y, z);
                return m;
            };

            // Main crown canopy
            group.add(makeFoliageCluster(0.95, 0, 3.2, 0));
            group.add(makeFoliageCluster(0.85, 0.3, 2.7, 0.2));
            group.add(makeFoliageCluster(0.8, -0.3, 2.6, -0.2));
            group.add(makeFoliageCluster(0.7, 0.2, 2.2, -0.3));

            // Branch clusters
            group.add(makeFoliageCluster(0.65, 0.7, 1.8, 0.4));
            group.add(makeFoliageCluster(0.6, -0.6, 2.0, -0.4));
            group.add(makeFoliageCluster(0.55, -0.5, 2.2, 0.4));

            return group;
        };

        const treePrototype = createDetailedTreeGeom();

        // Scatter 110 detailed trees along the valley banks and meadow ridges
        const treeCount = 110;
        const trees = [];
        let placed = 0;

        for (let i = 0; i < treeCount * 4 && placed < treeCount; i++) {
            const z = (Math.random() - 0.5) * 85;
            const rx = getRiverX(z);
            const side = Math.random() < 0.5 ? -1 : 1;
            const distFromBank = 4.2 + Math.random() * 28;
            const x = rx + side * distFromBank;

            // Keep waterfall canyon gorge clear of trees
            if (z < -41.0 && Math.abs(x - rx) < 9.5) continue;

            const y = getTerrainHeight(x, z);

            const tree = treePrototype.clone();
            const scale = 0.7 + Math.random() * 0.7;
            tree.position.set(x, y - 0.18, z); // Embed 1.28 units into terrain to eliminate slope cutoff
            tree.scale.set(scale, scale * (0.9 + Math.random() * 0.35), scale);
            tree.rotation.y = Math.random() * Math.PI * 2;
            tree.rotation.z = (Math.random() - 0.5) * 0.08;
            tree.userData = {
                baseRotX: tree.rotation.x,
                baseRotY: tree.rotation.y,
                baseRotZ: tree.rotation.z
            };

            scene.add(tree);
            trees.push(tree);
            placed++;
        }

        // --- 6. INSTANCED RIVER STONES & BOULDERS ---
        const stoneGeom = new THREE.DodecahedronGeometry(0.4, 0);
        const stoneMat = new THREE.MeshStandardMaterial({
            color: 0x0b1a26,
            roughness: 0.9,
            flatShading: true
        });
        const stoneCount = 45;
        const instancedStones = new THREE.InstancedMesh(stoneGeom, stoneMat, stoneCount);
        const dummy = new THREE.Object3D();

        let stonesPlaced = 0;
        for (let i = 0; i < stoneCount * 3 && stonesPlaced < stoneCount; i++) {
            const z = (Math.random() - 0.5) * 75;
            const rx = getRiverX(z);
            const side = Math.random() < 0.5 ? -1 : 1;
            const dist = 3.2 + Math.random() * 2.2;
            const x = rx + side * dist;
            const y = -0.15 + Math.random() * 0.2;

            const s = 0.5 + Math.random() * 0.7;
            dummy.position.set(x, y, z);
            dummy.scale.set(s, s * 0.6, s * (0.8 + Math.random() * 0.4));
            dummy.rotation.set(Math.random(), Math.random(), Math.random());
            dummy.updateMatrix();

            instancedStones.setMatrixAt(stonesPlaced, dummy.matrix);
            stonesPlaced++;
        }
        instancedStones.instanceMatrix.needsUpdate = true;
        scene.add(instancedStones);

        // --- 6B. TALL SILVER BIRCH TREES (SECOND FOREST SPECIES) ---
        const createBirchTree = () => {
            const group = new THREE.Group();

            // Slender birch trunk extending 1.3 units into the ground to anchor firmly on slopes
            const trunkGeom = new THREE.CylinderGeometry(0.08, 0.24, 5.2, 7);
            trunkGeom.translate(0, 1.3, 0); // Bottom is at y = -1.3, top is at y = +3.9
            const trunkMat = new THREE.MeshStandardMaterial({
                color: 0x1f2b38, // Silvery birch bark
                roughness: 0.75
            });
            const trunkMesh = new THREE.Mesh(trunkGeom, trunkMat);
            group.add(trunkMesh);

            const birchFoliageMat = new THREE.MeshStandardMaterial({
                color: 0x072528, // Crisp twilight birch foliage
                roughness: 0.75,
                flatShading: true
            });

            const addBirchCluster = (r, x, y, z) => {
                const geom = new THREE.IcosahedronGeometry(r, 1);
                const m = new THREE.Mesh(geom, birchFoliageMat);
                m.position.set(x, y, z);
                group.add(m);
            };

            addBirchCluster(0.85, 0, 3.8, 0);
            addBirchCluster(0.7, 0.25, 3.3, 0.15);
            addBirchCluster(0.65, -0.2, 3.1, -0.2);
            addBirchCluster(0.55, 0.35, 2.7, -0.1);

            return group;
        };

        const birchPrototype = createBirchTree();
        const birchCount = 42;
        const birchTrees = [];
        let birchesPlaced = 0;

        for (let i = 0; i < birchCount * 4 && birchesPlaced < birchCount; i++) {
            const z = (Math.random() - 0.5) * 85;
            const rx = getRiverX(z);
            const side = Math.random() < 0.5 ? -1 : 1;
            const distFromBank = 7.0 + Math.random() * 26; // High meadows and ridges
            const x = rx + side * distFromBank;
            const y = getTerrainHeight(x, z);

            const birch = birchPrototype.clone();
            const scale = 0.8 + Math.random() * 0.5;
            birch.position.set(x, y - 0.18, z); // Embed 1.48 units into terrain to eliminate slope cutoff
            birch.scale.set(scale, scale * (0.95 + Math.random() * 0.3), scale);
            birch.rotation.y = Math.random() * Math.PI * 2;
            birch.rotation.z = (Math.random() - 0.5) * 0.06;
            birch.userData = {
                baseRotX: birch.rotation.x,
                baseRotY: birch.rotation.y,
                baseRotZ: birch.rotation.z
            };

            scene.add(birch);
            birchTrees.push(birch);
            birchesPlaced++;
        }

        // --- 6C. ORGANIC ARCHING RIVERSIDE REEDS & CATTAILS ---
        // Construct curved reed stalk with natural parabolic arch & integrated velvety cattail head
        const reedGeom = new THREE.CylinderGeometry(0.015, 0.045, 2.1, 7, 14);
        reedGeom.translate(0, 1.05, 0);

        const rPos = reedGeom.attributes.position;
        const rColors = new Float32Array(rPos.count * 3);

        const colReedBase = new THREE.Color('#051516');    // Dark wet stem base
        const colReedGreen = new THREE.Color('#0a2b28');   // Deep reed green
        const colCattailHead = new THREE.Color('#1c140e'); // Velvety dark chocolate/amber cattail head
        const colReedTip = new THREE.Color('#0d3330');     // Tapered upper spike

        for (let i = 0; i < rPos.count; i++) {
            const rawY = rPos.getY(i); // 0 to 2.1
            const t = Math.max(0, rawY / 2.1);

            // Natural arching curvature: bends gracefully toward water with enhanced tip droop
            const arch = t * t * 0.65;
            const droop = Math.pow(t, 2.6) * 0.38;
            let vx = rPos.getX(i);
            let vz = rPos.getZ(i);

            // Cattail head bulge between y = 1.32 and 1.82
            let vertexCol = colReedGreen;
            if (rawY > 1.32 && rawY < 1.82) {
                const headT = Math.sin((rawY - 1.32) / 0.50 * Math.PI);
                const bulge = 1.0 + headT * 2.6; // Thick velvety cylinder
                vx *= bulge;
                vz *= bulge;
                vertexCol = colCattailHead;
            } else if (rawY <= 1.32) {
                const baseBlend = Math.min(rawY / 0.6, 1.0);
                vertexCol = colReedBase.clone().lerp(colReedGreen, baseBlend);
            } else {
                vertexCol = colReedTip;
            }

            rPos.setXYZ(i, vx + arch, rawY - droop, vz + arch * 0.32);

            rColors[i * 3 + 0] = vertexCol.r;
            rColors[i * 3 + 1] = vertexCol.g;
            rColors[i * 3 + 2] = vertexCol.b;
        }
        reedGeom.setAttribute('color', new THREE.BufferAttribute(rColors, 3));
        reedGeom.computeVertexNormals();

        const reedMat = new THREE.MeshStandardMaterial({
            vertexColors: true,
            roughness: 0.85,
            metalness: 0.08
        });

        const reedCount = 170;
        const instancedReeds = new THREE.InstancedMesh(reedGeom, reedMat, reedCount);
        const reedDummy = new THREE.Object3D();
        const reedOffsets = [];

        // Botanical reality: Cattails grow in dense colonial rhizome bunches (stands / clumps)
        // clustered in calm inner river coves and backwaters, with open shoreline between bunches!
        const reedBunches = [
            { z: 18.0, side: 1, count: 26, radius: 1.6 },   // Hero foreground right bank stand (visible immediately on load!)
            { z: 10.0, side: -1, count: 24, radius: 1.4 },  // Midground left bank bend stand
            { z: 0.0, side: 1, count: 28, radius: 1.8 },    // Calm inner river bend stand
            { z: -10.0, side: -1, count: 22, radius: 1.3 }, // Left bank wetland cove
            { z: -20.0, side: 1, count: 26, radius: 1.5 },  // Overlook right bank stand
            { z: -32.0, side: -1, count: 26, radius: 1.6 }, // Zone 4 horizon bend stand
            { z: 26.0, side: -1, count: 18, radius: 1.2 }   // Far south foreground left stand
        ];

        let reedsPlaced = 0;
        reedBunches.forEach((bunch) => {
            for (let j = 0; j < bunch.count && reedsPlaced < reedCount; j++) {
                const angle = Math.random() * Math.PI * 2;
                const r = Math.pow(Math.random(), 0.6) * bunch.radius;
                const z = bunch.z + Math.sin(angle) * r;
                const rx = getRiverX(z);
                const dist = 3.15 + Math.abs(Math.cos(angle) * r * 0.5) + Math.random() * 0.35;
                const x = rx + bunch.side * dist;
                const y = getTerrainHeight(x, z);

                reedDummy.position.set(x, y - 0.05, z);
                // Dense core has taller mature stalks, outer perimeter has shorter shoots
                const coreFactor = 1.0 - (r / bunch.radius) * 0.35;
                const s = (0.7 + Math.random() * 0.45) * coreFactor;
                reedDummy.scale.set(s, s * (0.95 + Math.random() * 0.3), s);

                // Point and hang noticeably outward over the water channel
                reedDummy.rotation.order = 'YXZ';
                const dx = rx - x;
                const dz = -0.15; // slight downstream flow bias
                const yaw = Math.atan2(-dz, dx) + (Math.random() - 0.5) * 0.28;
                // riverTilt tilts the stalk toward local +X (hanging out over the water)
                const riverTilt = -(0.28 + Math.random() * 0.24);
                const crossLean = (Math.random() - 0.5) * 0.16;

                reedDummy.rotation.set(crossLean, yaw, riverTilt, 'YXZ');
                reedDummy.updateMatrix();
                instancedReeds.setMatrixAt(reedsPlaced, reedDummy.matrix);

                reedOffsets.push({
                    pos: reedDummy.position.clone(),
                    scale: reedDummy.scale.clone(),
                    baseRot: reedDummy.rotation.clone()
                });
                reedsPlaced++;
            }
        });
        instancedReeds.instanceMatrix.needsUpdate = true;
        scene.add(instancedReeds);

        // --- 6D. BOTANICAL HIGH-CONTRAST WATER LILIES (NOTCHED LILY PADS & LOTUS BLOSSOMS) ---
        // Organic notched leaf with upturned rim and vivid emerald-to-bright-jade gradient
        const createLilyPadGeom = () => {
            const geom = new THREE.BufferGeometry();
            const segments = 24;
            const notchAngle = 0.45; // ~26° botanical V-notch opening
            const startAngle = notchAngle / 2;
            const endAngle = Math.PI * 2 - notchAngle / 2;
            const angleStep = (endAngle - startAngle) / segments;

            const positions = [];
            const colors = [];
            const indices = [];

            // Center vertex (leaf heart)
            positions.push(0, 0.002, 0);
            const colHeart = new THREE.Color('#022c22'); // Deep dark emerald heart
            const colMid = new THREE.Color('#059669');   // Lush vivid green blade
            const colRim = new THREE.Color('#34d399');   // Bright jade/lime contrast rim

            colors.push(colHeart.r, colHeart.g, colHeart.b);

            // Ring 1: Mid blade (r = 0.28)
            for (let i = 0; i <= segments; i++) {
                const theta = startAngle + i * angleStep;
                const r = 0.28;
                positions.push(Math.cos(theta) * r, 0.006, Math.sin(theta) * r);
                colors.push(colMid.r, colMid.g, colMid.b);
            }

            // Ring 2: Outer rim with gentle upturned curl (r = 0.44, y = 0.026)
            for (let i = 0; i <= segments; i++) {
                const theta = startAngle + i * angleStep;
                const wobble = 1.0 + Math.sin(theta * 5.0) * 0.04;
                const r = 0.44 * wobble;
                positions.push(Math.cos(theta) * r, 0.026, Math.sin(theta) * r);
                colors.push(colRim.r, colRim.g, colRim.b);
            }

            // Triangles from center to mid ring
            for (let i = 0; i < segments; i++) {
                indices.push(0, 1 + i, 1 + i + 1);
            }

            // Triangles between mid ring and outer rim
            const ring1Offset = 1;
            const ring2Offset = ring1Offset + segments + 1;
            for (let i = 0; i < segments; i++) {
                const a = ring1Offset + i;
                const b = ring1Offset + i + 1;
                const c = ring2Offset + i;
                const d = ring2Offset + i + 1;
                indices.push(a, d, b);
                indices.push(a, c, d);
            }

            geom.setAttribute('position', new THREE.Float32BufferAttribute(positions, 3));
            geom.setAttribute('color', new THREE.Float32BufferAttribute(colors, 3));
            geom.setIndex(indices);
            geom.computeVertexNormals();
            return geom;
        };

        // Delicate blooming lotus flower atop selected lily pads
        const createLotusBlossomGeom = () => {
            const geom = new THREE.BufferGeometry();
            const petalCount = 8;
            const positions = [];
            const colors = [];
            const indices = [];

            const colBase = new THREE.Color('#f472b6');   // Rose blush inner petal base
            const colTip = new THREE.Color('#fdf2f8');    // Star-white outer petal tip
            const colStamen = new THREE.Color('#fbbf24'); // Radiant golden stamen center

            // Center stamen cone (vertex 0)
            positions.push(0, 0.065, 0);
            colors.push(colStamen.r, colStamen.g, colStamen.b);

            // Ring of petal bases (vertices 1 .. petalCount)
            for (let i = 0; i < petalCount; i++) {
                const a = (i / petalCount) * Math.PI * 2;
                positions.push(Math.cos(a) * 0.045, 0.015, Math.sin(a) * 0.045);
                colors.push(colBase.r, colBase.g, colBase.b);
            }

            // Ring of pointed petal tips arching upward & outward (vertices petalCount+1 .. 2*petalCount)
            for (let i = 0; i < petalCount; i++) {
                const a = (i / petalCount) * Math.PI * 2;
                positions.push(Math.cos(a) * 0.15, 0.085, Math.sin(a) * 0.15);
                colors.push(colTip.r, colTip.g, colTip.b);
            }

            for (let i = 0; i < petalCount; i++) {
                const next = (i + 1) % petalCount;
                const b1 = 1 + i;
                const b2 = 1 + next;
                const t1 = 1 + petalCount + i;
                indices.push(0, b1, b2);  // Stamen center
                indices.push(b1, t1, b2); // Petal triangle
            }

            geom.setAttribute('position', new THREE.Float32BufferAttribute(positions, 3));
            geom.setAttribute('color', new THREE.Float32BufferAttribute(colors, 3));
            geom.setIndex(indices);
            geom.computeVertexNormals();
            return geom;
        };

        const lilyGeom = createLilyPadGeom();
        const lilyMat = new THREE.MeshStandardMaterial({
            vertexColors: true,
            roughness: 0.55,
            metalness: 0.10,
            side: THREE.DoubleSide
        });
        const lilyCount = 36;
        const instancedLilies = new THREE.InstancedMesh(lilyGeom, lilyMat, lilyCount);
        const lilyDummy = new THREE.Object3D();
        const lilyData = [];

        // Lotus flower blossoms on a portion of the pads
        const lotusGeom = createLotusBlossomGeom();
        const lotusMat = new THREE.MeshStandardMaterial({
            vertexColors: true,
            roughness: 0.45,
            metalness: 0.15,
            side: THREE.DoubleSide
        });
        const flowerCount = 14;
        const instancedFlowers = new THREE.InstancedMesh(lotusGeom, lotusMat, flowerCount);
        const flowerDummy = new THREE.Object3D();
        let flowersPlaced = 0;

        let liliesPlaced = 0;
        for (let i = 0; i < lilyCount * 4 && liliesPlaced < lilyCount; i++) {
            const z = (Math.random() - 0.5) * 75;
            const rx = getRiverX(z);
            const side = Math.random() < 0.5 ? -1 : 1;
            const dist = 1.0 + Math.random() * 1.7;
            const x = rx + side * dist;
            const y = -0.085;

            const s = 0.65 + Math.random() * 0.55;
            lilyDummy.position.set(x, y, z);
            lilyDummy.scale.set(s, 1.0, s * (0.85 + Math.random() * 0.3));
            lilyDummy.rotation.set(0, Math.random() * Math.PI * 2, 0);
            lilyDummy.updateMatrix();
            instancedLilies.setMatrixAt(liliesPlaced, lilyDummy.matrix);

            // Add flower blossom to roughly 40% of lily pads
            const hasFlower = flowersPlaced < flowerCount && Math.random() < 0.45;
            let flowerIndex = -1;
            if (hasFlower) {
                flowerIndex = flowersPlaced;
                flowerDummy.position.set(x, y + 0.02, z);
                flowerDummy.scale.set(s * 0.85, s * 0.85, s * 0.85);
                flowerDummy.rotation.set(0, Math.random() * Math.PI * 2, 0);
                flowerDummy.updateMatrix();
                instancedFlowers.setMatrixAt(flowersPlaced, flowerDummy.matrix);
                flowersPlaced++;
            }

            lilyData.push({
                x, z,
                baseY: y,
                scale: s,
                rotY: lilyDummy.rotation.y,
                phase: Math.random() * Math.PI * 2,
                flowerIndex: flowerIndex
            });
            liliesPlaced++;
        }
        instancedLilies.instanceMatrix.needsUpdate = true;
        scene.add(instancedLilies);

        if (flowersPlaced > 0) {
            instancedFlowers.instanceMatrix.needsUpdate = true;
            scene.add(instancedFlowers);
        }

        // --- 6E. LOW-LYING MOONLIT RIVER MIST (ATMOSPHERIC VAPORS) ---
        const mistCount = 130;
        const mistGeom = new THREE.BufferGeometry();
        const mistPos = new Float32Array(mistCount * 3);
        const mistSpeeds = new Float32Array(mistCount);

        for (let i = 0; i < mistCount; i++) {
            const z = (Math.random() - 0.5) * 80;
            const rx = getRiverX(z);
            mistPos[i * 3 + 0] = rx + (Math.random() - 0.5) * 5.2;
            mistPos[i * 3 + 1] = 0.18 + Math.random() * 0.6;
            mistPos[i * 3 + 2] = z;
            mistSpeeds[i] = 0.25 + Math.random() * 0.35;
        }
        mistGeom.setAttribute('position', new THREE.BufferAttribute(mistPos, 3));

        const mistCanvas = document.createElement('canvas');
        mistCanvas.width = 64;
        mistCanvas.height = 64;
        const mistCtx = mistCanvas.getContext('2d');
        if (mistCtx) {
            const grad = mistCtx.createRadialGradient(32, 32, 0, 32, 32, 32);
            grad.addColorStop(0, 'rgba(186, 230, 253, 0.16)');
            grad.addColorStop(0.45, 'rgba(125, 211, 252, 0.07)');
            grad.addColorStop(1, 'rgba(125, 211, 252, 0)');
            mistCtx.fillStyle = grad;
            mistCtx.fillRect(0, 0, 64, 64);
        }
        const mistTexture = new THREE.CanvasTexture(mistCanvas);

        const mistMat = new THREE.PointsMaterial({
            size: 2.6,
            map: mistTexture,
            transparent: true,
            opacity: 0.55,
            depthWrite: false,
            blending: THREE.AdditiveBlending
        });
        const riverMist = new THREE.Points(mistGeom, mistMat);
        scene.add(riverMist);

        // --- 6F. ULTRA-DENSE HIGH-RESOLUTION MEADOW GRASS (18,000 TUFTS / 54,000 BLADES) ---
        // Multi-blade organic tuft with 3 crossing curved blades per cluster for lush, continuous meadow coverage
        const createGrassTuftGeom = () => {
            const positions = [];
            const colors = [];
            const indices = [];

            // 3 blades per clump rotated at 0°, +62°, -58° with natural height and curl variations
            const blades = [
                { angle: 0.0,  curl: 0.14, width: 0.038, height: 0.62 },
                { angle: 1.08, curl: 0.12, width: 0.032, height: 0.52 },
                { angle: -1.02, curl: 0.13, width: 0.034, height: 0.56 }
            ];

            const colRoot = new THREE.Color('#031514');  // Dark moist root
            const colMid = new THREE.Color('#0a362c');   // Deep emerald blade
            const colTip = new THREE.Color('#226558');   // Starlit jade dew tip

            blades.forEach((b, bIdx) => {
                const baseIdx = bIdx * 5;
                const cosA = Math.cos(b.angle);
                const sinA = Math.sin(b.angle);

                const w = b.width;
                const h = b.height;
                const c = b.curl;

                // Root left & right (y = 0)
                positions.push(-w * cosA, 0.0, -w * sinA);
                colors.push(colRoot.r, colRoot.g, colRoot.b);

                positions.push(w * cosA, 0.0, w * sinA);
                colors.push(colRoot.r, colRoot.g, colRoot.b);

                // Mid left & right (y = h * 0.45, curled forward)
                const midW = w * 0.75;
                const midFwd = c * 0.35;
                positions.push(-midW * cosA - midFwd * sinA, h * 0.45, -midW * sinA + midFwd * cosA);
                colors.push(colMid.r, colMid.g, colMid.b);

                positions.push(midW * cosA - midFwd * sinA, h * 0.45, midW * sinA + midFwd * cosA);
                colors.push(colMid.r, colMid.g, colMid.b);

                // Tip (y = h, curled forward)
                positions.push(-c * sinA, h, c * cosA);
                colors.push(colTip.r, colTip.g, colTip.b);

                // 3 triangles per blade
                indices.push(
                    baseIdx + 0, baseIdx + 1, baseIdx + 2,
                    baseIdx + 1, baseIdx + 3, baseIdx + 2,
                    baseIdx + 2, baseIdx + 3, baseIdx + 4
                );
            });

            const geom = new THREE.BufferGeometry();
            geom.setAttribute('position', new THREE.Float32BufferAttribute(positions, 3));
            geom.setAttribute('color', new THREE.Float32BufferAttribute(colors, 3));
            geom.setIndex(indices);
            geom.computeVertexNormals();
            return geom;
        };

        const grassGeom = createGrassTuftGeom();

        const grassMat = new THREE.MeshStandardMaterial({
            vertexColors: true,
            roughness: 0.82,
            metalness: 0.08,
            side: THREE.DoubleSide
        });

        // 100% GPU Wind Sway Displacement: zero CPU cost!
        grassMat.onBeforeCompile = (shader) => {
            shader.uniforms.uTime = { value: 0 };
            shader.vertexShader = `
                uniform float uTime;
            ` + shader.vertexShader;
            shader.vertexShader = shader.vertexShader.replace(
                '#include <begin_vertex>',
                `
                #include <begin_vertex>
                float hFactor = clamp(transformed.y / 0.62, 0.0, 1.0);
                vec4 wPos = instanceMatrix * vec4(0.0, 0.0, 0.0, 1.0);

                // Unified gentle wind field matching JavaScript getWindAt
                float wanderAngle = sin(uTime * 0.08) * 0.85 + cos(uTime * 0.043) * 0.55 + 0.8;
                float wave1 = sin(wPos.x * 0.055 + wPos.z * 0.075 - uTime * 1.05);
                float wave2 = cos(wPos.x * 0.095 - wPos.z * 0.065 - uTime * 1.45) * 0.35;
                float wave3 = sin(wPos.x * 0.035 - wPos.z * 0.040 + uTime * 0.45) * 0.20;
                float gust = 0.60 + 0.30 * wave1 + 0.12 * wave2 + 0.08 * wave3;
                float localAngle = wanderAngle + (wave2 + wave3) * 0.18;

                vec2 windDir = vec2(cos(localAngle), sin(localAngle));
                float dispStrength = gust * 0.10 * hFactor;

                transformed.x += windDir.x * dispStrength;
                transformed.z += windDir.y * dispStrength;
                `
            );
            grassMat.userData.shader = shader;
        };

        const grassCount = 18000;
        const instancedGrass = new THREE.InstancedMesh(grassGeom, grassMat, grassCount);
        const gDummy = new THREE.Object3D();

        let grassPlaced = 0;
        for (let i = 0; i < grassCount * 3 && grassPlaced < grassCount; i++) {
            const z = (Math.random() - 0.5) * 88;
            const rx = getRiverX(z);
            const side = Math.random() < 0.5 ? -1 : 1;
            // Spread across all rolling hills from bank crest (3.5) out to edges (28)
            const dist = 3.5 + Math.pow(Math.random(), 0.82) * 24.5;
            const x = rx + side * dist;
            const y = getTerrainHeight(x, z);

            gDummy.position.set(x, y - 0.01, z);
            const s = 0.65 + Math.random() * 0.7;
            gDummy.scale.set(s, s * (0.85 + Math.random() * 0.35), s);
            gDummy.rotation.set(
                (Math.random() - 0.5) * 0.25,
                Math.random() * Math.PI * 2,
                (Math.random() - 0.5) * 0.25
            );
            gDummy.updateMatrix();
            instancedGrass.setMatrixAt(grassPlaced, gDummy.matrix);
            grassPlaced++;
        }
        instancedGrass.instanceMatrix.needsUpdate = true;
        scene.add(instancedGrass);

        // --- 7. CELESTIAL MOON & STARDUST SKY ---
        const starCount = 500;
        const starGeom = new THREE.BufferGeometry();
        const starPos = new Float32Array(starCount * 3);

        for (let i = 0; i < starCount; i++) {
            starPos[i * 3 + 0] = (Math.random() - 0.5) * 120;
            starPos[i * 3 + 1] = Math.random() * 45 + 10;
            starPos[i * 3 + 2] = (Math.random() - 0.5) * 100 - 30;
        }
        starGeom.setAttribute('position', new THREE.BufferAttribute(starPos, 3));

        const starMat = new THREE.PointsMaterial({
            size: 0.15,
            color: 0xe0f2fe,
            transparent: true,
            opacity: 0.85,
            blending: THREE.AdditiveBlending
        });
        const stars = new THREE.Points(starGeom, starMat);
