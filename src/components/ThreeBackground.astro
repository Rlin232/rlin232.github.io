        let meteorActive = false;
        let meteorStartTime = 0;
        let nextMeteorTime = 5.0;
        const meteorStart = new THREE.Vector3();
        const meteorEnd = new THREE.Vector3();

        // --- 7C. TRUE 3D SPHERICAL MOON WITH PROCEDURAL MARIA, CRATERS & CORONA ---
        // 1. High-resolution 3D Moon Sphere Geometry (64x64 segments for mathematically smooth spherical silhouette)
        const moonGeom = new THREE.SphereGeometry(4.4, 64, 64);
        const moonMat = new THREE.ShaderMaterial({
            transparent: false,
            depthWrite: true,
            depthTest: true,
            vertexShader: `
                varying vec3 vSphereNormal;
                varying vec3 vLocalPos;
                varying vec3 vWorldPos;
                varying vec3 vViewDir;

                void main() {
                    vLocalPos = normalize(position);
                    vSphereNormal = normalize(normalMatrix * normal);
                    vec4 worldPos = modelMatrix * vec4(position, 1.0);
                    vWorldPos = worldPos.xyz;
                    vViewDir = normalize(cameraPosition - worldPos.xyz);
                    gl_Position = projectionMatrix * viewMatrix * worldPos;
                }
            `,
            fragmentShader: `
                varying vec3 vSphereNormal;
                varying vec3 vLocalPos;
                varying vec3 vWorldPos;
                varying vec3 vViewDir;

                float hash3(vec3 p) {
                    p = fract(p * 0.3183099 + 0.1);
                    p *= 17.0;
                    return fract(p.x * p.y * p.z * (p.x + p.y + p.z));
                }

                float noise3(vec3 x) {
                    vec3 p = floor(x);
                    vec3 w = fract(x);
                    vec3 u = w * w * (3.0 - 2.0 * w);
                    float n = p.x + p.y * 157.0 + 113.0 * p.z;
                    return mix(mix(mix(hash3(p), hash3(p + vec3(1,0,0)), u.x),
                                   mix(hash3(p + vec3(0,1,0)), hash3(p + vec3(1,1,0)), u.x), u.y),
                               mix(mix(hash3(p + vec3(0,0,1)), hash3(p + vec3(1,0,1)), u.x),
                                   mix(hash3(p + vec3(0,1,1)), hash3(p + vec3(1,1,1)), u.x), u.y), u.z);
                }

                float fbm3(vec3 p) {
                    float v = 0.0;
                    float a = 0.5;
                    for (int i = 0; i < 5; i++) {
                        v += a * noise3(p);
                        p = p * 2.08 + vec3(0.18, 0.32, 0.45);
                        a *= 0.5;
                    }
                    return v;
                }

                void main() {
                    vec3 p = vLocalPos;

                    // 1. Broad Lunar Maria (dark basaltic volcanic plains)
                    float mariaNoise = fbm3(p * 2.6);
                    float isMare = smoothstep(0.38, 0.64, mariaNoise);

                    // 2. Distinct Lunar Crater Basins (Raised bright rims & shadowed floors)
                    float crater1 = length(p - normalize(vec3(0.18, 0.28, 0.93)));   // Copernicus
                    float crater2 = length(p - normalize(vec3(-0.32, -0.42, 0.86))); // Tycho
                    float crater3 = length(p - normalize(vec3(-0.46, 0.12, 0.88)));  // Kepler
                    float crater4 = length(p - normalize(vec3(0.52, -0.18, 0.82)));  // Mare Crisium

                    float rim1 = exp(-pow((crater1 - 0.22) * 22.0, 2.0)) * 0.65;
                    float floor1 = smoothstep(0.22, 0.09, crater1) * 0.45;

                    float rim2 = exp(-pow((crater2 - 0.18) * 24.0, 2.0)) * 0.85;
                    float floor2 = smoothstep(0.18, 0.08, crater2) * 0.50;

                    float rim3 = exp(-pow((crater3 - 0.14) * 26.0, 2.0)) * 0.55;

                    // 3. Tycho Ray System: brilliant ejecta streaks radiating across the highlands
                    vec3 tychoCenter = normalize(vec3(-0.32, -0.42, 0.86));
                    vec3 dTycho = p - tychoCenter;
                    float tychoDist = length(dTycho);
                    float tychoAngle = atan(dTycho.y, dTycho.x);
                    float tychoRays = pow(max(0.0, sin(tychoAngle * 9.0)), 5.0) * exp(-tychoDist * 2.2) * 0.58;

                    // Dense multi-scale impact crater micro-relief
                    float microCraters = noise3(p * 15.0) * 0.16 + noise3(p * 32.0) * 0.08;

                    // High-contrast color palette: deep basaltic slate vs brilliant silvery highlands
                    vec3 colMare = vec3(0.20, 0.28, 0.38);       // Dark basaltic sea
                    vec3 colHighland = vec3(0.95, 0.98, 1.0);     // Brilliant silvery starlight highland
                    vec3 colRims = vec3(1.0, 1.0, 1.0);           // Pure bright crater rim highlights

                    float albedo = mix(0.18, 0.94, isMare) + rim1 + rim2 + rim3 + tychoRays + microCraters - floor1 - floor2;
                    albedo = clamp(albedo, 0.0, 1.0);

                    vec3 surfaceCol = mix(colMare, colHighland, albedo);
                    surfaceCol += colRims * (rim1 * 0.45 + rim2 * 0.65 + tychoRays * 0.35);

                    // 4. True 3D Spherical Diffuse Lighting & Terminator Relief
                    vec3 moonLightDir = normalize(vec3(0.18, 0.45, 0.87));
                    float nDotL = dot(vSphereNormal, moonLightDir);
                    float sphericalLight = max(0.10, nDotL * 0.82 + 0.18);

                    // Lunar limb darkening (Fresnel soft edge)
                    float vDotN = max(0.0, dot(vViewDir, vSphereNormal));
                    float limb = pow(vDotN, 0.26);

                    vec3 finalMoon = surfaceCol * sphericalLight * limb;
                    gl_FragColor = vec4(finalMoon, 1.0);
                }
            `
        });
        const moon = new THREE.Mesh(moonGeom, moonMat);
        moon.position.set(-1.2, 8.2, -62.0);
        moon.lookAt(getRiverX(0), 6.5, 0);
        moon.rotateY(Math.PI); // Orient the detailed cratered hemisphere directly toward camera
        scene.add(moon);

        // 2. Soft Atmospheric Corona Glow Billboard behind the 3D Moon
        const coronaCanvas = document.createElement('canvas');
        coronaCanvas.width = 128;
        coronaCanvas.height = 128;
        const cCtx = coronaCanvas.getContext('2d');
        if (cCtx) {
            const grad = cCtx.createRadialGradient(64, 64, 28, 64, 64, 64);
            grad.addColorStop(0, 'rgba(186, 230, 253, 0.75)');
            grad.addColorStop(0.35, 'rgba(56, 189, 248, 0.35)');
            grad.addColorStop(0.70, 'rgba(14, 165, 233, 0.12)');
            grad.addColorStop(1, 'rgba(5, 8, 19, 0)');
            cCtx.fillStyle = grad;
            cCtx.fillRect(0, 0, 128, 128);
        }
        const coronaTexture = new THREE.CanvasTexture(coronaCanvas);
        const coronaMat = new THREE.SpriteMaterial({
            map: coronaTexture,
            transparent: true,
            blending: THREE.AdditiveBlending,
            depthWrite: false,
            opacity: 0.85
        });
        const moonCorona = new THREE.Sprite(coronaMat);
        moonCorona.position.copy(moon.position);
        moonCorona.scale.set(15.0, 15.0, 1.0);
        scene.add(moonCorona);

        // --- 8. SERENE FLOATING CELESTIAL STARDUST & FIREFLIES ---
        const fireflyCount = 240;
        const fireflyGeom = new THREE.BufferGeometry();
        const pPos = new Float32Array(fireflyCount * 3);
        const pColors = new Float32Array(fireflyCount * 3);
        const pSpeeds = new Float32Array(fireflyCount);
        const pPhases = new Float32Array(fireflyCount);

        // Warm bioluminescent yellow firefly tones
        const luminousYellow = new THREE.Color('#fef08a'); // Soft luminous yellow
        const warmGold = new THREE.Color('#facc15');       // Golden yellow firefly glow
        const amberGold = new THREE.Color('#f59e0b');      // Warm twilight amber

        for (let i = 0; i < fireflyCount; i++) {
            const z = (Math.random() - 0.5) * 75;
            const rx = getRiverX(z);
            pPos[i * 3 + 0] = rx + (Math.random() - 0.5) * 24;
            pPos[i * 3 + 1] = Math.random() * 5.0 + 0.3;
            pPos[i * 3 + 2] = z;

            pSpeeds[i] = 0.3 + Math.random() * 0.5;
            pPhases[i] = Math.random() * Math.PI * 2;

            const c = Math.random() < 0.50 ? luminousYellow : Math.random() < 0.85 ? warmGold : amberGold;
            pColors[i * 3 + 0] = c.r;
            pColors[i * 3 + 1] = c.g;
            pColors[i * 3 + 2] = c.b;
        }

        fireflyGeom.setAttribute('position', new THREE.BufferAttribute(pPos, 3));
        fireflyGeom.setAttribute('color', new THREE.BufferAttribute(pColors, 3));

        const dotCanvas = document.createElement('canvas');
        dotCanvas.width = 48;
        dotCanvas.height = 48;
        const dotCtx = dotCanvas.getContext('2d');
        if (dotCtx) {
            const grad = dotCtx.createRadialGradient(24, 24, 0, 24, 24, 24);
            grad.addColorStop(0, 'rgba(255, 255, 200, 1.0)');
            grad.addColorStop(0.28, 'rgba(254, 240, 138, 0.95)');
            grad.addColorStop(0.60, 'rgba(250, 204, 21, 0.55)');
            grad.addColorStop(1, 'rgba(234, 179, 8, 0)');
            dotCtx.fillStyle = grad;
            dotCtx.fillRect(0, 0, 48, 48);
        }
        const fireflyTexture = new THREE.CanvasTexture(dotCanvas);

        const fireflyMat = new THREE.PointsMaterial({
            size: 0.24,
            map: fireflyTexture,
            transparent: true,
            vertexColors: true,
            blending: THREE.AdditiveBlending,
            depthWrite: false,
            opacity: 0.85
        });
        const fireflies = new THREE.Points(fireflyGeom, fireflyMat);
        scene.add(fireflies);

        // --- 9. BUTTER-SMOOTH CONTINUOUS WATER RAYCASTING ---
        const raycaster = new THREE.Raycaster();
        const waterMathPlane = new THREE.Plane(new THREE.Vector3(0, 1, 0), 0.1);
        const mouseNDC = new THREE.Vector2(0, 0);
        const smoothMouseNDC = new THREE.Vector2(0, 0);
        const hitPoint = new THREE.Vector3();
        const smoothWaterCursor = new THREE.Vector3(getRiverX(16), -0.1, 16);
        const prevWaterCursor = new THREE.Vector3(getRiverX(16), -0.1, 16);
        let smoothCursorSpeed = 0.0;
        let isMouseActive = true;

        let mouseX = 0, mouseY = 0;
        let targetMouseX = 0, targetMouseY = 0;

        const RIPPLE_COUNT = 8;
        let currentRippleIndex = 0;
        let lastSpawnPos = new THREE.Vector2(999, 999);
        let lastSpawnTime = 0;

        window.addEventListener('mousemove', (e) => {
            mouseNDC.x = (e.clientX / window.innerWidth) * 2 - 1;
            mouseNDC.y = -(e.clientY / window.innerHeight) * 2 + 1;
            isMouseActive = true;
        });

        window.addEventListener('mouseleave', () => {
            isMouseActive = false;
        });

        // --- 10. SAFE NON-CLIPPING CAMERA WAYPOINTS WITH ALTERNATING BANK STAGING ---
        // Dynamically frames the river on one side while opening the opposite bank for content
        const waypoints = [
            // Zone 0: Valley Overlook (Hero) - centered overview
            {
                cam: new THREE.Vector3(getRiverX(24), 7.2, 24),
                look: new THREE.Vector3(getRiverX(6), 1.8, 6)
            },
            // Zone 1: West Bank (About) - camera offsets East, framing river on right and West bank on left
            {
                cam: new THREE.Vector3(getRiverX(13) + 3.8, 4.4, 15),
                look: new THREE.Vector3(getRiverX(8) - 3.8, 2.0, 8)
            },
            // Zone 2: East Bank (Research) - camera offsets West, framing river on left and East bank on right
            {
                cam: new THREE.Vector3(getRiverX(0) - 4.2, 4.6, 2),
                look: new THREE.Vector3(getRiverX(-5) + 3.8, 2.2, -5)
            },
            // Zone 3: West Bank (Publications) - camera offsets East, framing river on right and West bank on left
            {
                cam: new THREE.Vector3(getRiverX(-14) + 4.2, 4.8, -12),
                look: new THREE.Vector3(getRiverX(-19) - 3.8, 2.3, -19)
            },
            // Zone 4: East Bank (Experience) - camera offsets West, framing river on left and East bank on right
            {
                cam: new THREE.Vector3(getRiverX(-27) - 4.0, 5.0, -25),
                look: new THREE.Vector3(getRiverX(-32) + 3.8, 2.5, -32)
            },
            // Zone 5: West Bank (Projects) - camera offsets East, framing river on right and West bank on left
            {
                cam: new THREE.Vector3(getRiverX(-36), 7.2, -34),
                look: new THREE.Vector3(getRiverX(-54), 2.8, -54)
            },
            // Zone 6: Celestial Horizon (Contact) - panoramic overlook at the brink of the waterfall
            {
                cam: new THREE.Vector3(getRiverX(-39), 7.8, -37),
                look: new THREE.Vector3(getRiverX(-60), 2.6, -59)
            }
        ];

        let targetCamPos = new THREE.Vector3().copy(waypoints[0].cam);
        let targetLookAt = new THREE.Vector3().copy(waypoints[0].look);
        let currentLookAt = new THREE.Vector3().copy(waypoints[0].look);

        // Section Metric Tracker: Maps DOM section center points to camera waypoints
        const sectionIds = ['hero', 'about', 'research', 'publications', 'journey', 'projects', 'contact'];
        let sectionProgressPoints = [0, 0.17, 0.33, 0.50, 0.67, 0.83, 1.0];

        const updateSectionMetrics = () => {
            const maxScroll = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
            const scrollY = window.scrollY;

            const pts = sectionIds.map((id, idx) => {
                const el = document.getElementById(id);
                if (!el) return idx / (sectionIds.length - 1);
                const rect = el.getBoundingClientRect();
                const absoluteTop = scrollY + rect.top;
                const centerScroll = absoluteTop + rect.height * 0.5 - window.innerHeight * 0.5;
                return Math.max(0, Math.min(1, centerScroll / maxScroll));
            });

            pts[0] = 0;
            pts[pts.length - 1] = 1;
            for (let i = 1; i < pts.length; i++) {
                if (pts[i] <= pts[i - 1]) pts[i] = pts[i - 1] + 0.04;
            }
            sectionProgressPoints = pts;
        };

        const updateCameraFromScroll = () => {
            const scrollY = window.scrollY;
            const maxScroll = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
            const progress = maxScroll > 0 ? Math.min(Math.max(scrollY / maxScroll, 0), 1) : 0;

            let index = 0;
            for (let i = 0; i < sectionProgressPoints.length - 1; i++) {
                if (progress >= sectionProgressPoints[i] && progress <= sectionProgressPoints[i + 1]) {
                    index = i;
                    break;
                }
            }

            const p0Prog = sectionProgressPoints[index];
            const p1Prog = sectionProgressPoints[index + 1] || 1;
            const span = Math.max(0.0001, p1Prog - p0Prog);
            const localT = Math.min(Math.max((progress - p0Prog) / span, 0), 1);

            // Hermite cubic ease
            const easeT = localT * localT * (3 - 2 * localT);

            const p0 = waypoints[index];
            const p1 = waypoints[Math.min(index + 1, waypoints.length - 1)];

            targetCamPos.lerpVectors(p0.cam, p1.cam, easeT);
            targetLookAt.lerpVectors(p0.look, p1.look, easeT);
        };

        window.addEventListener('scroll', updateCameraFromScroll, { passive: true });
        window.addEventListener('resize', updateSectionMetrics);
        setTimeout(updateSectionMetrics, 200);
        updateCameraFromScroll();
        updateCameraFromScroll();

        const handleResize = () => {
            const { w, h } = getViewportSize();
            camera.aspect = w / h;
            camera.updateProjectionMatrix();
            renderer.setSize(w, h, false);
        };
        window.addEventListener('resize', handleResize);
        window.addEventListener('orientationchange', () => {
            setTimeout(handleResize, 100);
        });
        handleResize();

        // Main Animation Loop
        const clock = new THREE.Clock();
        let lastTime = 0;

        const animate = () => {
            const time = clock.getElapsedTime();
            const dt = Math.min(time - lastTime, 0.1) || 0.016;
            lastTime = time;

            // Butter-smooth mouse screen coordinates lerp
            smoothMouseNDC.lerp(mouseNDC, 0.22);
            targetMouseX = smoothMouseNDC.x;
            targetMouseY = smoothMouseNDC.y;

            mouseX += (targetMouseX - mouseX) * 0.05;
            mouseY += (targetMouseY - mouseY) * 0.05;

            // Smooth camera gliding
            camera.position.x += (targetCamPos.x + mouseX * 0.85 - camera.position.x) * 0.06;
            camera.position.y += (targetCamPos.y + mouseY * 0.4 - camera.position.y) * 0.06;
            camera.position.z += (targetCamPos.z - camera.position.z) * 0.06;

            // --- STRICT TERRAIN ANTI-CLIPPING GUARANTEE ---
            const groundUnderCam = getTerrainHeight(camera.position.x, camera.position.z);
            const minSafeHeight = groundUnderCam + 2.4;
            if (camera.position.y < minSafeHeight) {
                camera.position.y += (minSafeHeight - camera.position.y) * 0.3;
            }

            currentLookAt.x += (targetLookAt.x + mouseX * 0.4 - currentLookAt.x) * 0.06;
            currentLookAt.y += (targetLookAt.y + mouseY * 0.2 - currentLookAt.y) * 0.06;
            currentLookAt.z += (targetLookAt.z - currentLookAt.z) * 0.06;

            camera.lookAt(currentLookAt);

            // Water animation
            waterMat.uniforms.uTime.value = time;

            // --- REAL-TIME EXACT WATER RAYCASTING ---
            raycaster.setFromCamera(smoothMouseNDC, camera);
            const riverHits = raycaster.intersectObject(river);
            let hasHit = false;

            if (riverHits.length > 0) {
                hitPoint.copy(riverHits[0].point);
                hasHit = true;
            } else {
                // Fallback to mathematical water plane if grazing near shoreline
                const planeHit = raycaster.ray.intersectPlane(waterMathPlane, hitPoint);
                if (planeHit) {
                    const rx = getRiverX(hitPoint.z);
                    if (Math.abs(hitPoint.x - rx) < 6.5) {
                        hasHit = true;
                    }
                }
            }

            if (hasHit && isMouseActive) {
                // Rapidly glide 3D water cursor toward hit point
                smoothWaterCursor.lerp(hitPoint, 0.45);

                // Compute instantaneous velocity on water surface
                const stepDist = Math.hypot(smoothWaterCursor.x - prevWaterCursor.x, smoothWaterCursor.z - prevWaterCursor.z);
                const instSpeed = stepDist * 55.0;
                smoothCursorSpeed += (instSpeed - smoothCursorSpeed) * 0.28;
                prevWaterCursor.copy(smoothWaterCursor);

                // River channel proximity check
                const rx = getRiverX(smoothWaterCursor.z);
                const distToRiver = Math.abs(smoothWaterCursor.x - rx);
                const channelProximity = Math.max(0, Math.min(1.0, (6.8 - distToRiver) / 2.5));

                // Update continuous hydrodynamic cursor uniform: (x, z, smoothSpeed, activeIntensity)
                waterMat.uniforms.uWaterCursor.value.set(
                    smoothWaterCursor.x,
                    smoothWaterCursor.z,
                    smoothCursorSpeed,
                    channelProximity
                );

                // Spawn trailing expanding wave pulses with tuned gentle amplitude
                const distFromLastSpawn = Math.hypot(smoothWaterCursor.x - lastSpawnPos.x, smoothWaterCursor.z - lastSpawnPos.y);
                if (channelProximity > 0.05 && (distFromLastSpawn > 0.35 || (time - lastSpawnTime > 0.12 && distFromLastSpawn > 0.08))) {
                    const pulseStrength = Math.min(Math.max(smoothCursorSpeed * 0.25 + 0.35, 0.35), 0.85);
                    rippleUniforms[currentRippleIndex].set(smoothWaterCursor.x, smoothWaterCursor.z, time, pulseStrength);
                    currentRippleIndex = (currentRippleIndex + 1) % RIPPLE_COUNT;
                    lastSpawnPos.set(smoothWaterCursor.x, smoothWaterCursor.z);
                    lastSpawnTime = time;
                }
            } else {
                // Fade out cursor influence smoothly
                waterMat.uniforms.uWaterCursor.value.w *= 0.90;
            }

            // --- UNIFIED, GENTLE, SPATIALLY-COHERENT WIND FIELD ---
            // Pines, birches, and riverside reeds all respond to the exact same continuous wind field
            // Nearby objects in close patches sway in the same direction and phase!
            trees.forEach((tree) => {
                const w = getWindAt(tree.position.x, tree.position.z, time);
                const sway = 0.022 * w.strength;
                tree.rotation.z = tree.userData.baseRotZ - w.dirX * sway;
                tree.rotation.x = tree.userData.baseRotX + w.dirZ * sway;
            });

            birchTrees.forEach((tree) => {
                const w = getWindAt(tree.position.x, tree.position.z, time);
                const sway = 0.034 * w.strength;
                tree.rotation.z = tree.userData.baseRotZ - w.dirX * sway;
                tree.rotation.x = tree.userData.baseRotX + w.dirZ * sway;
            });

            // Riverside reeds bend together in patches along the passing breeze
            for (let i = 0; i < reedCount; i++) {
                const r = reedOffsets[i];
                if (!r) continue;
                const w = getWindAt(r.pos.x, r.pos.z, time);
                const sway = 0.055 * w.strength;
                const bendX = w.dirZ * sway;
                const bendZ = -w.dirX * sway;

                reedDummy.position.copy(r.pos);
                reedDummy.scale.copy(r.scale);
                reedDummy.rotation.set(
                    r.baseRot.x + bendX,
                    r.baseRot.y,
                    r.baseRot.z + bendZ,
                    'YXZ'
                );
                reedDummy.updateMatrix();
                instancedReeds.setMatrixAt(i, reedDummy.matrix);
            }
            instancedReeds.instanceMatrix.needsUpdate = true;

            // 100% GPU-computed wind waves across the 9,000 hill grass blades
            if (grassMat.userData.shader) {
                grassMat.userData.shader.uniforms.uTime.value = time;
            }

            // --- PRECISE REAL-TIME WATER SURFACE ELEVATION SAMPLER ---
            // Samples exact instantaneous fluid displacement (all 4 waves + wake + ripples) at any (x, z)
            const getWaterSurfaceY = (wx, wz, t) => {
                let y = -0.10;

                // Gerstner Wave 1 (wavelength 7.5, speed 0.85)
                const k1 = 6.2831853 / 7.5;
                const c1 = Math.sqrt(9.81 / k1) * 0.85;
                const a1 = 0.12 / k1;
                const d1x = 0.05 / Math.hypot(0.05, 0.998), d1z = 0.998 / Math.hypot(0.05, 0.998);
                y += a1 * Math.sin(k1 * (d1x * wx + d1z * wz - c1 * t));

                // Gerstner Wave 2 (wavelength 4.4, speed 1.05)
                const k2 = 6.2831853 / 4.4;
                const c2 = Math.sqrt(9.81 / k2) * 1.05;
                const a2 = 0.07 / k2;
                const d2x = -0.06 / Math.hypot(-0.06, 0.998), d2z = 0.998 / Math.hypot(-0.06, 0.998);
                y += a2 * Math.sin(k2 * (d2x * wx + d2z * wz - c2 * t));

                // Gerstner Wave 3 (wavelength 2.2, speed 1.30)
                const k3 = 6.2831853 / 2.2;
                const c3 = Math.sqrt(9.81 / k3) * 1.30;
                const a3 = 0.035 / k3;
                const d3x = 0.08 / Math.hypot(0.08, 0.996), d3z = 0.996 / Math.hypot(0.08, 0.996);
                y += a3 * Math.sin(k3 * (d3x * wx + d3z * wz - c3 * t));

                // Gerstner Wave 4 (wavelength 1.1, speed 1.55)
                const k4 = 6.2831853 / 1.1;
                const c4 = Math.sqrt(9.81 / k4) * 1.55;
                const a4 = 0.020 / k4;
                const d4x = -0.05 / Math.hypot(-0.05, 0.998), d4z = 0.998 / Math.hypot(-0.05, 0.998);
                y += a4 * Math.sin(k4 * (d4x * wx + d4z * wz - c4 * t));

                // Continuous Cursor Wake
                const uCursor = waterMat.uniforms.uWaterCursor.value;
                if (uCursor.w > 0.01) {
                    const dist = Math.hypot(wx - uCursor.x, wz - uCursor.y);
                    const radius = 3.0;
                    const wake = Math.exp(-dist * dist / (radius * radius)) * uCursor.w;
                    const speed = uCursor.z;
                    const depressMult = Math.min(Math.max(speed * 0.14 + 0.55, 0.55), 0.88);
                    const rippleMult = Math.min(Math.max(speed * 0.16 + 0.55, 0.55), 0.90);
                    y -= wake * 0.24 * depressMult;
                    y += Math.sin(dist * 6.2 - t * 7.5) * wake * 0.20 * rippleMult;
                }

                // Expanding ripple wave pulses
                for (let rIdx = 0; rIdx < RIPPLE_COUNT; rIdx++) {
                    const rip = rippleUniforms[rIdx];
                    const age = t - rip.z;
                    if (age > 0.0 && age < 4.8) {
                        const dist = Math.hypot(wx - rip.x, wz - (rip.y + age * 0.85));
                        const delta = dist - (age * 3.8);
                        const fadeIn = Math.min(Math.max(age / 0.20, 0), 1);
                        const fadeOut = Math.exp(-age * 0.65);
                        const envelope = Math.exp(-delta * delta * 0.85) * fadeIn * fadeOut;
                        y += Math.sin(delta * 5.6) * envelope * 0.18 * rip.w;
                    }
                }

                return y;
            };

            // Lily pads & blooming lotus flowers float dynamically on instantaneous water surface (NEVER get submerged!)
            for (let i = 0; i < lilyCount; i++) {
                const pad = lilyData[i];
                if (!pad) continue;

                // Sample water height at pad center AND 4 perimeter locations (radius = pad.scale * 0.42)
                // This ensures that even when two waves cross off-center, the pad rises to clear the highest crest!
                const r = pad.scale * 0.42;
                const yC = getWaterSurfaceY(pad.x, pad.z, time);
                const yE = getWaterSurfaceY(pad.x + r, pad.z, time);
                const yW = getWaterSurfaceY(pad.x - r, pad.z, time);
                const yN = getWaterSurfaceY(pad.x, pad.z - r, time);
                const yS = getWaterSurfaceY(pad.x, pad.z + r, time);

                // Maximum water height across the entire pad footprint
                const maxWaterY = Math.max(yC, yE, yW, yN, yS);

                // Raised baseline height (+0.035 above center, or +0.026 above highest crest) so it never gets clipped
                const currentY = Math.max(yC + 0.035, maxWaterY + 0.026);

                // Accurate central difference tilt along X and Z
                const slopeX = (yE - yW) / (2 * r);
                const slopeZ = (yS - yN) / (2 * r);
                const tiltZ = -Math.atan(slopeX) * 0.85;
                const tiltX = Math.atan(slopeZ) * 0.85;

                lilyDummy.position.set(pad.x, currentY, pad.z);
                lilyDummy.scale.set(pad.scale, 1.0, pad.scale);
                lilyDummy.rotation.set(tiltX, pad.rotY, tiltZ);
                lilyDummy.updateMatrix();
                instancedLilies.setMatrixAt(i, lilyDummy.matrix);

                // Synchronize flower blossom floating atop its parent pad
                if (pad.flowerIndex >= 0 && pad.flowerIndex < flowerCount) {
                    flowerDummy.position.set(pad.x, currentY + 0.016, pad.z);
                    flowerDummy.scale.set(pad.scale * 0.85, pad.scale * 0.85, pad.scale * 0.85);
                    flowerDummy.rotation.set(tiltX, pad.rotY, tiltZ);
                    flowerDummy.updateMatrix();
                    instancedFlowers.setMatrixAt(pad.flowerIndex, flowerDummy.matrix);
                }
            }
            instancedLilies.instanceMatrix.needsUpdate = true;
            if (flowersPlaced > 0) {
                instancedFlowers.instanceMatrix.needsUpdate = true;
            }

            // River mist drifting downstream
            const mPos = mistGeom.attributes.position;
            for (let i = 0; i < mistCount; i++) {
                let z = mPos.getZ(i);
                z += mistSpeeds[i] * 0.032;
                if (z > 42) z = -45;
                mPos.setZ(i, z);

                const rx = getRiverX(z);
                let x = mPos.getX(i);
                if (Math.abs(x - rx) > 3.4) {
                    x = rx + (Math.sin(time * 0.2 + i) * 2.5);
                    mPos.setX(i, x);
                }
            }
            mPos.needsUpdate = true;

            // Celestial meteor shooting star streak
            if (!meteorActive && time > nextMeteorTime) {
                meteorActive = true;
                meteorStartTime = time;
                nextMeteorTime = time + 7.5 + Math.random() * 6.0;
                const startX = (Math.random() - 0.5) * 55 - 15;
                const startY = 22 + Math.random() * 12;
                const startZ = -45 - Math.random() * 20;
                meteorStart.set(startX, startY, startZ);
                meteorEnd.set(startX + 24, startY - 14, startZ);
            }

            if (meteorActive) {
                const meteorAge = time - meteorStartTime;
                const meteorDuration = 0.95;
                if (meteorAge < meteorDuration) {
                    const t = meteorAge / meteorDuration;
                    const head = meteorStart.clone().lerp(meteorEnd, t);
                    const tail = meteorStart.clone().lerp(meteorEnd, Math.max(0, t - 0.24));
                    const mPosAttr = meteorGeom.attributes.position;
                    mPosAttr.setXYZ(0, tail.x, tail.y, tail.z);
                    mPosAttr.setXYZ(1, head.x, head.y, head.z);
                    mPosAttr.needsUpdate = true;
                    const alpha = Math.sin(t * Math.PI);
                    meteorMat.opacity = alpha * 0.85;
                } else {
                    meteorActive = false;
                    meteorMat.opacity = 0.0;
                }
            }

            // Animate fireflies
            const pos = fireflyGeom.attributes.position;
            for (let i = 0; i < fireflyCount; i++) {
                let y = pos.getY(i);
                let x = pos.getX(i);

                y += Math.sin(time * pSpeeds[i] + pPhases[i]) * 0.007;
                x += Math.cos(time * 0.4 * pSpeeds[i] + pPhases[i]) * 0.004;

                if (y < 0.2) y = 4.8;
                if (y > 5.2) y = 0.3;

                pos.setY(i, y);
                pos.setX(i, x);
            }
            pos.needsUpdate = true;

            // Twinkle stars gently
            starMat.opacity = 0.75 + Math.sin(time * 1.5) * 0.15;

            // Moon & Corona soft breathing in upper twilight sky (lowered on small viewports so it never goes behind navbar)
            const isSmallViewport = window.innerWidth < 768 || camera.aspect < 1.0;
            const baseMoonY = isSmallViewport ? 3.2 : 10.6;
            const moonBreathe = baseMoonY + Math.sin(time * 0.3) * 0.12;
            moon.position.y = moonBreathe;
            moonCorona.position.y = moonBreathe;

            renderer.render(scene, camera);
            requestAnimationFrame(animate);
        };

        animate();
    }
</script>
