---
import "../styles/global.css";
import ThreeBackground from "../components/ThreeBackground.astro";

interface Props {
	title: string;
	description?: string;
	hideFooter?: boolean;
}

const {
	title,
	description = "Ryan Lin – AI Researcher, Stanford M.S. CS, Caltech graduate, and swimmer.",
	hideFooter = false,
} = Astro.props;

const isHome = Astro.url.pathname === "/" || Astro.url.pathname === "";
const navPrefix = isHome ? "" : "/";
---

<!doctype html>
<html lang="en" class="min-h-full scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta
			name="viewport"
			content="width=device-width, initial-scale=1.0, viewport-fit=cover"
		/>
		<meta name="theme-color" content="#050813" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta
			name="apple-mobile-web-app-status-bar-style"
			content="black-translucent"
		/>
		<link rel="icon" type="image/svg+xml" href="/assets/img/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>

		<!-- Elegant Modern Google Fonts: Outfit (Warm Headings) & Inter (Serene Body) -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Inter:wght@300;400;500;600&display=swap"
			rel="stylesheet"
		/>

		<!-- Lenis Smooth Scrolling via CDN -->
		<script
			src="https://cdn.jsdelivr.net/gh/studio-freight/lenis@1.0.29/bundled/lenis.min.js"
		></script>
	</head>
	<body
		class="relative min-h-full bg-[#050813] text-slate-100 font-sans selection:bg-sky-400/20 selection:text-sky-200 antialiased"
	>
		<!-- Serene 3D Twilight Waterscape & Fireflies Scene -->
		<ThreeBackground />

		<!-- Peaceful Navigation Header -->
		<header
			class="fixed top-0 left-0 w-full z-50 transition-all duration-300 py-3.5 px-4 sm:px-6 md:px-12 backdrop-blur-md bg-[#050813]/80 border-b border-white/5"
		>
			<div class="max-w-6xl mx-auto flex items-center justify-between">
				<!-- Left Area: Hamburger (Mobile) + Brand Identity -->
				<div class="flex items-center gap-1.5 sm:gap-2">
					<!-- Mobile Hamburger Menu Button -->
					<button
						id="mobile-nav-toggle"
						class="md:hidden p-1.5 -ml-1 text-slate-300 hover:text-white rounded-lg hover:bg-white/10 active:scale-95 transition-all cursor-hover"
						aria-label="Toggle navigation menu"
						aria-expanded="false"
					>
						<svg
							id="hamburger-svg"
							class="w-5 h-5 transition-transform duration-200"
							fill="none"
							viewBox="0 0 24 24"
							stroke="currentColor"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="2"
								d="M4 6h16M4 12h16M4 18h16"></path>
						</svg>
						<svg
							id="close-svg"
							class="w-5 h-5 hidden transition-transform duration-200"
							fill="none"
							viewBox="0 0 24 24"
							stroke="currentColor"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="2"
								d="M6 18L18 6M6 6l12 12"></path>
						</svg>
					</button>

					<!-- Brand Identity: Clean Typography (No Emblem) -->
					<a
						href="/"
						class="group flex items-center gap-2 cursor-hover"
					>
						<span
							class="font-outfit text-base font-semibold tracking-tight text-white group-hover:text-sky-300 transition-colors"
						>
							Ryan Lin
						</span>
						<span
							class="text-xs text-slate-500 font-light hidden sm:inline"
						>
							/ AI Researcher
						</span>
					</a>
				</div>

				<!-- Peaceful Navigation Links -->
				<nav
					class="hidden md:flex items-center gap-6 text-sm text-slate-300 font-medium"
				>
					<a
						href={`${navPrefix}#about`}
						class="hover:text-sky-300 transition-colors cursor-hover"
						>About</a
					>
					<a
						href={`${navPrefix}#research`}
						class="hover:text-sky-300 transition-colors cursor-hover"
						>Research</a
					>
					<a
						href={`${navPrefix}#publications`}
						class="hover:text-sky-300 transition-colors cursor-hover"
						>Publications</a
					>
					<a
						href={`${navPrefix}#journey`}
						class="hover:text-sky-300 transition-colors cursor-hover"
						>Journey</a
					>
					<a
						href={`${navPrefix}#projects`}
						class="hover:text-sky-300 transition-colors cursor-hover"
						>Projects</a
					>
					<a
						href={`${navPrefix}#contact`}
						class="hover:text-sky-300 transition-colors cursor-hover"
						>Contact</a
					>
				</nav>

				<!-- Controls & CV -->
				<div class="flex items-center gap-2.5 sm:gap-3">
					<!-- Nature Wind Chime Synthesizer Toggle -->
					<button
						id="chime-toggle"
						class="text-xs px-3 py-1.5 rounded-full border border-white/10 text-slate-400 hover:text-sky-300 hover:border-sky-400/30 bg-white/5 transition-all flex items-center gap-1.5 cursor-hover"
						title="Toggle ambient water chimes"
					>
						<span id="chime-label">Sound: Off</span>
					</button>

					<!-- Full CV -->
					<a
						href="/cv"
						class="text-xs px-4 py-1.5 rounded-full bg-sky-500/10 hover:bg-sky-500/20 text-sky-300 border border-sky-500/30 transition-all font-medium flex items-center gap-1 cursor-hover"
					>
						<span>CV</span>
						<svg
							class="w-3 h-3"
							fill="none"
							stroke="currentColor"
							viewBox="0 0 24 24"
							><path
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="2"
								d="M9 5l7 7-7 7"></path></svg
						>
					</a>
				</div>
			</div>

			<!-- Mobile Dropdown Navigation Drawer -->
			<div
				id="mobile-nav-menu"
				class="hidden md:hidden overflow-hidden transition-all duration-300 ease-in-out border-t border-white/10 mt-3 pt-3 pb-2"
			>
				<nav
					class="flex flex-col space-y-1 text-sm font-medium text-slate-200"
				>
					<a
						href={`${navPrefix}#about`}
						class="mobile-menu-item py-2.5 px-3 rounded-xl hover:bg-white/5 hover:text-sky-300 transition-colors flex items-center justify-between"
					>
						<span>About</span>
						<span class="text-xs text-slate-500 font-mono">01</span>
					</a>
					<a
						href={`${navPrefix}#research`}
						class="mobile-menu-item py-2.5 px-3 rounded-xl hover:bg-white/5 hover:text-sky-300 transition-colors flex items-center justify-between"
					>
						<span>Research</span>
						<span class="text-xs text-slate-500 font-mono">02</span>
					</a>
					<a
						href={`${navPrefix}#publications`}
						class="mobile-menu-item py-2.5 px-3 rounded-xl hover:bg-white/5 hover:text-sky-300 transition-colors flex items-center justify-between"
					>
						<span>Publications</span>
						<span class="text-xs text-slate-500 font-mono">03</span>
					</a>
					<a
						href={`${navPrefix}#journey`}
						class="mobile-menu-item py-2.5 px-3 rounded-xl hover:bg-white/5 hover:text-sky-300 transition-colors flex items-center justify-between"
					>
						<span>Journey</span>
						<span class="text-xs text-slate-500 font-mono">04</span>
					</a>
					<a
						href={`${navPrefix}#projects`}
						class="mobile-menu-item py-2.5 px-3 rounded-xl hover:bg-white/5 hover:text-sky-300 transition-colors flex items-center justify-between"
					>
						<span>Projects</span>
						<span class="text-xs text-slate-500 font-mono">05</span>
					</a>
					<a
						href={`${navPrefix}#contact`}
						class="mobile-menu-item py-2.5 px-3 rounded-xl hover:bg-white/5 hover:text-sky-300 transition-colors flex items-center justify-between"
					>
						<span>Contact</span>
						<span class="text-xs text-slate-500 font-mono">06</span>
					</a>
				</nav>
			</div>
		</header>

		<!-- Main Content -->
		<main class="relative z-10 min-h-screen overflow-x-clip">
			<slot />
		</main>

		<!-- Serene Footer -->
		{
			!hideFooter && (
				<footer class="hidden md:block relative z-10 border-t border-white/5 bg-[#050813]/85 backdrop-blur-xl py-14 px-6 md:px-12 mt-32">
					<div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6 text-sm text-slate-400">
						<div class="flex flex-col items-center md:items-start gap-1">
							<span class="text-slate-200 font-outfit font-medium">
								Ryan Lin
							</span>
							<span class="text-xs text-slate-500">
								Exploring and developing intelligent systems.
							</span>
						</div>

						<div class="flex flex-wrap items-center justify-center gap-6 text-sm">
							<a
								href="https://github.com/rlin232"
								target="_blank"
								rel="noopener noreferrer"
								class="hover:text-sky-300 transition-colors cursor-hover"
							>
								GitHub
							</a>
							<a
								href="https://linkedin.com/in/ryan-lin232"
								target="_blank"
								rel="noopener noreferrer"
								class="hover:text-sky-300 transition-colors cursor-hover"
							>
								LinkedIn
							</a>
							<a
								href="https://scholar.google.com/citations?hl=en&user=3i8ThuwAAAAJ"
								target="_blank"
								rel="noopener noreferrer"
								class="hover:text-sky-300 transition-colors cursor-hover"
							>
								Google Scholar
							</a>
							<a
								href="mailto:rlin232@stanford.edu"
								class="hover:text-sky-300 transition-colors cursor-hover"
							>
								Email
							</a>
							<a
								href="/cv"
								class="text-sky-400 hover:text-sky-300 transition-colors cursor-hover"
							>
								CV
							</a>
						</div>
					</div>
				</footer>
			)
		}

		<!-- Gentle Ambient Cursor -->
		<div
			id="ambient-cursor"
			class="fixed w-3 h-3 bg-sky-300 rounded-full pointer-events-none z-[9999] -translate-x-1/2 -translate-y-1/2 transition-transform duration-100 ease-out hidden md:block shadow-[0_0_12px_rgba(125,211,252,0.8)]"
		>
		</div>
		<div
			id="ambient-cursor-ring"
			class="fixed w-8 h-8 border border-sky-300/30 rounded-full pointer-events-none z-[9998] -translate-x-1/2 -translate-y-1/2 transition-all duration-300 ease-out hidden md:block"
		>
		</div>

		<!-- Client Scripts: Lenis + Peaceful Wind Chime Synthesizer -->
		<script is:inline>
			// Web Audio Peaceful Wind Chimes Synthesizer (Zero MP3s)
			let audioCtx = null;
			let chimesEnabled = false;
			let tuneTimeout = null;
			let scheduledNoteTimeouts = [];
			let masterGain = null;

			const initAudio = () => {
				try {
					if (!audioCtx) {
						const AudioContextClass =
							window.AudioContext || window.webkitAudioContext;
						if (AudioContextClass) {
							audioCtx = new AudioContextClass();
							masterGain = audioCtx.createGain();
							masterGain.gain.setValueAtTime(
								0.25,
								audioCtx.currentTime,
							);
							masterGain.connect(audioCtx.destination);
						}
					}
					if (audioCtx) {
						if (audioCtx.state === "suspended") {
							audioCtx.resume();
						}
						// Play an inaudible 1-sample buffer synchronously to unlock iOS Safari WebAudio engine
						const buffer = audioCtx.createBuffer(1, 1, 22050);
						const source = audioCtx.createBufferSource();
						source.buffer = buffer;
						source.connect(audioCtx.destination);
						source.start(0);
					}
					// Prime iOS media session with a tiny silent data URI audio element
					const silentAudio = new Audio(
						"data:audio/wav;base64,UklGRiQAAABXQVZFZm10IBAAAAABAAEARKwAAIhYAQACABAAZGF0YQAAAAA=",
					);
					silentAudio.volume = 0.01;
					silentAudio.play().catch(() => {});
				} catch (e) {}
			};

			const playChimeNote = (freq, duration = 2.4, pan = 0) => {
				if (!chimesEnabled || !audioCtx) return;
				try {
					if (audioCtx.state === "suspended") {
						audioCtx.resume();
					}
					const now = audioCtx.currentTime;

					// Fundamental Oscillator
					const osc1 = audioCtx.createOscillator();
					const gain1 = audioCtx.createGain();
					osc1.type = "sine";
					osc1.frequency.setValueAtTime(freq, now);

					// Bell envelope: smooth attack, gentle exponential decay
					gain1.gain.setValueAtTime(0.001, now);
					gain1.gain.exponentialRampToValueAtTime(0.32, now + 0.02);
					gain1.gain.exponentialRampToValueAtTime(
						0.0001,
						now + duration,
					);

					// Metallic overtone (2.756x fundamental - characteristic of real chime pipes)
					const osc2 = audioCtx.createOscillator();
					const gain2 = audioCtx.createGain();
					osc2.type = "sine";
					osc2.frequency.setValueAtTime(freq * 2.756, now);

					gain2.gain.setValueAtTime(0.001, now);
					gain2.gain.exponentialRampToValueAtTime(0.1, now + 0.015);
					gain2.gain.exponentialRampToValueAtTime(
						0.0001,
						now + duration * 0.45,
					);

					// Stereo panning (with safe fallback for browsers without StereoPannerNode)
					let dest = masterGain;
					if (typeof audioCtx.createStereoPanner === "function") {
						try {
							const panner = audioCtx.createStereoPanner();
							panner.pan.setValueAtTime(pan, now);
							panner.connect(masterGain);
							dest = panner;
						} catch (e) {
							dest = masterGain;
						}
					}

					osc1.connect(gain1);
					gain1.connect(dest);
					osc2.connect(gain2);
					gain2.connect(dest);

					osc1.start(now);
					osc1.stop(now + duration);
					osc2.start(now);
					osc2.stop(now + duration * 0.5);
				} catch (e) {}
			};

			// A soothing pentatonic chime tune (G major / E minor pentatonic)
			const chimeTune = [
				{ freq: 587.33, delay: 0, pan: -0.2 }, // D5
				{ freq: 783.99, delay: 380, pan: 0.2 }, // G5
				{ freq: 659.25, delay: 820, pan: -0.1 }, // E5
				{ freq: 493.88, delay: 1300, pan: 0.15 }, // B4
				{ freq: 587.33, delay: 1850, pan: -0.05 }, // D5

				{ freq: 392.0, delay: 2700, pan: -0.2 }, // G4
				{ freq: 493.88, delay: 3100, pan: 0.1 }, // B4
				{ freq: 587.33, delay: 3500, pan: -0.15 }, // D5
				{ freq: 659.25, delay: 4000, pan: 0.2 }, // E5
				{ freq: 783.99, delay: 4800, pan: 0.0, dur: 2.8 }, // G5 (rings out)

				{ freq: 587.33, delay: 5900, pan: -0.1 }, // D5
				{ freq: 493.88, delay: 6500, pan: 0.15 }, // B4
				{ freq: 392.0, delay: 7100, pan: -0.05, dur: 3.2 }, // G4 (calm resonant resolve)
			];

			const stopTune = () => {
				if (tuneTimeout) {
					clearTimeout(tuneTimeout);
					tuneTimeout = null;
				}
				scheduledNoteTimeouts.forEach((t) => clearTimeout(t));
				scheduledNoteTimeouts = [];
			};

			const playTune = () => {
				if (!chimesEnabled) return;
				stopTune();

				chimeTune.forEach((note) => {
					if (note.delay === 0) {
						// Play note 0 synchronously in the direct user gesture stack
						playChimeNote(note.freq, note.dur || 2.4, note.pan);
					} else {
						const tId = setTimeout(() => {
							if (chimesEnabled) {
								playChimeNote(
									note.freq,
									note.dur || 2.4,
									note.pan,
								);
							}
						}, note.delay);
						scheduledNoteTimeouts.push(tId);
					}
				});

				// Loop the tune peacefully every 14.5 seconds if sound remains enabled
				tuneTimeout = setTimeout(() => {
					if (chimesEnabled) {
						playTune();
					}
				}, 14500);
			};

			// Chime toggle button
			const chimeBtn = document.getElementById("chime-toggle");
			const chimeLabel = document.getElementById("chime-label");

			if (chimeBtn) {
				const handleToggle = () => {
					initAudio();
					chimesEnabled = !chimesEnabled;
					if (chimesEnabled) {
						chimeLabel.innerText = "Sound: On";
						chimeBtn.classList.add(
							"border-sky-400/40",
							"text-sky-300",
							"bg-sky-500/10",
						);
						playTune();
					} else {
						chimeLabel.innerText = "Sound: Off";
						chimeBtn.classList.remove(
							"border-sky-400/40",
							"text-sky-300",
							"bg-sky-500/10",
						);
						stopTune();
					}
				};

				chimeBtn.addEventListener("click", handleToggle);
			}

			// Lenis Smooth Scroll Setup
			if (typeof Lenis !== "undefined") {
				const lenis = new Lenis({
					duration: 1.2,
					easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
					orientation: "vertical",
					gestureOrientation: "vertical",
					smoothWheel: true,
					wheelMultiplier: 1.0,
				});

				function raf(time) {
					lenis.raf(time);
					requestAnimationFrame(raf);
				}
				requestAnimationFrame(raf);

				// Smooth anchor scroll
				document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
					anchor.addEventListener("click", function (e) {
						const href = this.getAttribute("href");
						if (href && href.length > 1) {
							e.preventDefault();
							const target = document.querySelector(href);
							if (target) {
								lenis.scrollTo(target, { offset: -70 });
							}
						}
					});
				});
			}

			// Gentle Cursor Follower
			const cursor = document.getElementById("ambient-cursor");
			const cursorRing = document.getElementById("ambient-cursor-ring");

			if (cursor && cursorRing) {
				let mouseX = 0,
					mouseY = 0;
				let ringX = 0,
					ringY = 0;

				document.addEventListener("mousemove", (e) => {
					mouseX = e.clientX;
					mouseY = e.clientY;
					cursor.style.left = mouseX + "px";
					cursor.style.top = mouseY + "px";
				});

				function animateCursor() {
					ringX += (mouseX - ringX) * 0.12;
					ringY += (mouseY - ringY) * 0.12;
					cursorRing.style.left = ringX + "px";
					cursorRing.style.top = ringY + "px";
					requestAnimationFrame(animateCursor);
				}
				requestAnimationFrame(animateCursor);

				// Subtle cursor expansion on hover (purely visual, no sound)
				document
					.querySelectorAll("a, button, .cursor-hover")
					.forEach((el) => {
						el.addEventListener("mouseenter", () => {
							cursorRing.style.transform =
								"translate(-50%, -50%) scale(1.6)";
							cursorRing.style.borderColor =
								"rgba(186, 230, 253, 0.6)";
						});
						el.addEventListener("mouseleave", () => {
							cursorRing.style.transform =
								"translate(-50%, -50%) scale(1)";
							cursorRing.style.borderColor =
								"rgba(186, 230, 253, 0.3)";
						});
					});
			}

			// Mobile Menu Drawer Toggle
			const mobileNavBtn = document.getElementById("mobile-nav-toggle");
			const mobileNavMenu = document.getElementById("mobile-nav-menu");
			const hamburgerSvg = document.getElementById("hamburger-svg");
			const closeSvg = document.getElementById("close-svg");

			if (mobileNavBtn && mobileNavMenu) {
				const toggleMobileMenu = (forceState) => {
					const willOpen =
						forceState !== undefined
							? forceState
							: mobileNavMenu.classList.contains("hidden");
					if (willOpen) {
						mobileNavMenu.classList.remove("hidden");
						hamburgerSvg?.classList.add("hidden");
						closeSvg?.classList.remove("hidden");
						mobileNavBtn.setAttribute("aria-expanded", "true");
					} else {
						mobileNavMenu.classList.add("hidden");
						hamburgerSvg?.classList.remove("hidden");
						closeSvg?.classList.add("hidden");
						mobileNavBtn.setAttribute("aria-expanded", "false");
					}
				};

				mobileNavBtn.addEventListener("click", (e) => {
					e.stopPropagation();
					toggleMobileMenu();
				});

				// Close when clicking any menu link
				document
					.querySelectorAll(".mobile-menu-item")
					.forEach((link) => {
						link.addEventListener("click", () => {
							toggleMobileMenu(false);
						});
					});

				// Close when clicking outside
				document.addEventListener("click", (e) => {
					if (
						!mobileNavMenu.contains(e.target) &&
						!mobileNavBtn.contains(e.target)
					) {
						toggleMobileMenu(false);
					}
				});
			}
		</script>
	</body>
</html>
